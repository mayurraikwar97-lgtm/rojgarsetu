        && isValidApplication(incoming())
        && (
          (incoming().workerUid == request.auth.uid && incoming().status == 'applied') ||
          (incoming().employerUid == request.auth.uid && incoming().status == 'invited')
        )
        && incoming().liveTrackingAuthorized == false
        && isValidTimestampOnCreate()
        && get(/databases/$(database)/documents/jobs/$(incoming().jobId)).data.employerUid == incoming().employerUid;
      allow update: if isValidId(applicationId)
        && isVerifiedUser()
        && isValidApplication(incoming())
        && isValidTimestampOnUpdate()
        && incoming().jobId == existing().jobId
        && incoming().employerUid == existing().employerUid
        && incoming().workerUid == existing().workerUid
        && (
          isAdmin() ||
          (
            !(existing().status == 'work_completed' || ('dealStatus' in existing() && existing().dealStatus in ['WORK_COMPLETED', 'CANCELLED']))
            && isOwner(existing().workerUid)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'dealStatus', 'proposedWage', 'offerAmount', 'travelCharges', 'estimatedArrivalTime',
              'offerMessage', 'offerSubmittedAt', 'note', 'liveTrackingAuthorized',
              'dealConfirmedAt', 'onTheWayAt', 'arrivedAt', 'workStartedAt', 'completedAt', 'cancelledAt',
              'cancelledByUid', 'quoteRevisionRequested', 'updatedAt'
            ])
            && incoming().status in ['applied', 'accepted', 'declined', 'work_completed']
            && (incoming().status != 'accepted' || existing().status in ['invited', 'accepted'])
            && (incoming().status != 'work_completed' || existing().status == 'accepted')
            && (!incoming().liveTrackingAuthorized || existing().status == 'accepted' || existing().status == 'invited')
          ) ||
          (
            !(existing().status == 'work_completed' || ('dealStatus' in existing() && existing().dealStatus in ['WORK_COMPLETED', 'CANCELLED']))
            && isOwner(existing().employerUid)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'dealStatus', 'agreedPrice', 'dealConfirmedAt',
              'liveTrackingAuthorized', 'completedAt', 'cancelledAt', 'cancelledByUid',
              'quoteRevisionRequested', 'workerRating', 'employerFeedback', 'updatedAt'
            ])
            && incoming().status in ['invited', 'accepted', 'declined', 'work_completed']
            && (!('liveTrackingAuthorized' in incoming()) || !incoming().liveTrackingAuthorized || incoming().status == 'accepted')
          ) ||
          (
            existing().status == 'work_completed'
            && !('workerRating' in existing())
            && isOwner(existing().employerUid)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'workerRating', 'employerFeedback', 'updatedAt'
            ])
            && 'workerRating' in incoming()
            && incoming().workerRating is number
            && incoming().workerRating >= 1
            && incoming().workerRating <= 5
          )
        );
      allow delete: if isValidId(applicationId) && isAdmin();
