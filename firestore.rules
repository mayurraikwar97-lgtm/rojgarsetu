          ) ||
          (
            existing().status == 'open'
            && 'acceptedApplicationId' in incoming()
            && 'acceptedWorkerUid' in incoming()
            && incoming().acceptedWorkerUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['acceptedApplicationId', 'acceptedWorkerUid', 'dealStatus', 'status', 'updatedAt'])
            && incoming().status == 'in_progress'
            && incoming().dealStatus in ['OFFER_ACCEPTED', 'DEAL_CONFIRMED']
            && exists(/databases/$(database)/documents/applications/$(incoming().acceptedApplicationId))
            && get(/databases/$(database)/documents/applications/$(incoming().acceptedApplicationId)).data.workerUid == request.auth.uid
            && get(/databases/$(database)/documents/applications/$(incoming().acceptedApplicationId)).data.jobId == jobId
            && get(/databases/$(database)/documents/applications/$(incoming().acceptedApplicationId)).data.status in ['invited', 'accepted']
          )
        );
      allow delete: if isValidId(jobId) && isAdmin();
