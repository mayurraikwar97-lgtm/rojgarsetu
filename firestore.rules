      return data.keys().hasAll([
          'orderCode', 'ownerUid', 'customerDemoUserId', 'customerName', 'customerUniqueId',
          'serviceCategory', 'title', 'description', 'state', 'district', 'cityOrVillage',
          'requestLat', 'requestLng', 'offeredWage', 'wageUnit', 'status',
          'matchedWorkerIds', 'matchedWorkerOwnerUids', 'rejectedWorkerIds',
          'customerLocationSharing', 'workerLocationSharing', 'isDemo', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'orderCode', 'ownerUid', 'customerDemoUserId', 'customerName', 'customerUniqueId',
          'serviceCategory', 'title', 'description', 'state', 'district', 'cityOrVillage',
          'requestLat', 'requestLng', 'offeredWage', 'wageUnit', 'status',
          'matchedWorkerIds', 'matchedWorkerOwnerUids', 'rejectedWorkerIds',
          'acceptedWorkerId', 'acceptedWorkerOwnerUid', 'acceptedWorkerName', 'acceptedWorkerUniqueId',
          'acceptedWorkerPhotoDocId', 'customerConfirmedAt', 'completedAt', 'closedAt',
          'customerLocationSharing', 'workerLocationSharing',
          'completionNotes', 'workerRating', 'isDemo', 'createdAt', 'updatedAt'
        ])
        && data.orderCode is string && data.orderCode.size() >= 5 && data.orderCode.size() <= 48
        && isValidId(data.ownerUid)
        && isValidId(data.customerDemoUserId)
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 120
        && data.customerUniqueId is string && data.customerUniqueId.size() >= 5 && data.customerUniqueId.size() <= 48
        && data.serviceCategory is string && data.serviceCategory.size() >= 2 && data.serviceCategory.size() <= 80
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 160
        && data.description is string && data.description.size() >= 5 && data.description.size() <= 1000
        && data.state is string && data.state.size() >= 2 && data.state.size() <= 80
        && data.district is string && data.district.size() >= 2 && data.district.size() <= 80
        && data.cityOrVillage is string && data.cityOrVillage.size() >= 2 && data.cityOrVillage.size() <= 100
        && data.requestLat is number && data.requestLat >= -90 && data.requestLat <= 90
        && data.requestLng is number && data.requestLng >= -180 && data.requestLng <= 180
        && data.offeredWage is number && data.offeredWage >= 0 && data.offeredWage <= 500000
        && data.wageUnit in ['daily', 'monthly', 'hourly', 'contract']
        && data.status in ['requested', 'accepted', 'customer_confirmed', 'in_progress', 'completed', 'closed', 'declined', 'cancelled']
        && data.matchedWorkerIds is list && data.matchedWorkerIds.size() <= 10
        && (data.matchedWorkerIds.size() == 0 || data.matchedWorkerIds[0] is string)
        && data.matchedWorkerOwnerUids is list && data.matchedWorkerOwnerUids.size() <= 10
        && (data.matchedWorkerOwnerUids.size() == 0 || data.matchedWorkerOwnerUids[0] is string)
        && data.rejectedWorkerIds is list && data.rejectedWorkerIds.size() <= 10
        && (data.rejectedWorkerIds.size() == 0 || data.rejectedWorkerIds[0] is string)
        && (!('acceptedWorkerId' in data) || isValidId(data.acceptedWorkerId))
        && (!('acceptedWorkerOwnerUid' in data) || isValidId(data.acceptedWorkerOwnerUid))
        && (!('acceptedWorkerName' in data) || (data.acceptedWorkerName is string && data.acceptedWorkerName.size() <= 120))
        && (!('acceptedWorkerUniqueId' in data) || (data.acceptedWorkerUniqueId is string && data.acceptedWorkerUniqueId.size() <= 48))
        && (!('acceptedWorkerPhotoDocId' in data) || isValidId(data.acceptedWorkerPhotoDocId))
        && (!('customerConfirmedAt' in data) || data.customerConfirmedAt is timestamp)
        && (!('completedAt' in data) || data.completedAt is timestamp)
        && (!('closedAt' in data) || data.closedAt is timestamp)
        && data.customerLocationSharing is bool
        && data.workerLocationSharing is bool
        && (!('completionNotes' in data) || (data.completionNotes is string && data.completionNotes.size() <= 500))
        && (!('workerRating' in data) || (data.workerRating is number && data.workerRating >= 1 && data.workerRating <= 5))
        && data.isDemo == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDemoLiveLocationShare(data) {
      return data.keys().hasAll([
          'orderId', 'ownerUid', 'authorizedOwnerUids', 'demoUserId', 'participantRole',
          'participantName', 'lat', 'lng', 'accuracyMeters', 'sharingActive', 'permissionState',
          'source', 'isDemo', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'orderId', 'ownerUid', 'authorizedOwnerUids', 'demoUserId', 'participantRole',
          'participantName', 'lat', 'lng', 'accuracyMeters', 'sharingActive', 'permissionState',
          'source', 'isDemo', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.orderId)
        && isValidId(data.ownerUid)
        && data.authorizedOwnerUids is list && data.authorizedOwnerUids.size() >= 1 && data.authorizedOwnerUids.size() <= 4
        && data.authorizedOwnerUids[0] is string
        && isValidId(data.demoUserId)
        && data.participantRole in ['customer', 'worker']
        && data.participantName is string && data.participantName.size() >= 2 && data.participantName.size() <= 120
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.accuracyMeters is number && data.accuracyMeters >= 0 && data.accuracyMeters <= 200000
        && data.sharingActive is bool
        && data.permissionState in ['granted', 'denied', 'prompt', 'manual_fallback']
        && data.source in ['gps_watch', 'gps_once', 'simulated_move']
        && data.isDemo == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDemoNotificationRecord(data) {
      return data.keys().hasAll([
          'dedupeKey', 'recipientDemoUserId', 'recipientName', 'recipientRole',
          'recipientOwnerUid', 'senderOwnerUid', 'ownerUid', 'orderId',
          'eventType', 'title', 'body', 'inAppDelivered', 'browserNotificationStatus',
          'fcmPushStatus', 'read', 'isDemo', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'dedupeKey', 'recipientDemoUserId', 'recipientName', 'recipientRole',
          'recipientOwnerUid', 'senderOwnerUid', 'ownerUid', 'orderId',
          'eventType', 'title', 'body', 'inAppDelivered', 'browserNotificationStatus',
          'fcmPushStatus', 'fcmErrorReason', 'read', 'isDemo', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.dedupeKey)
        && isValidId(data.recipientDemoUserId)
        && data.recipientName is string && data.recipientName.size() >= 2 && data.recipientName.size() <= 120
        && data.recipientRole in ['customer', 'worker']
        && isValidId(data.recipientOwnerUid)
        && isValidId(data.senderOwnerUid)
        && isValidId(data.ownerUid)
        && isValidId(data.orderId)
        && data.eventType in ['job_request', 'job_accepted', 'customer_confirmed', 'job_started', 'job_rejected', 'job_completed', 'deal_closed', 'location_started', 'location_stopped']
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 160
        && data.body is string && data.body.size() >= 2 && data.body.size() <= 500
        && data.inAppDelivered is bool
        && data.browserNotificationStatus in ['delivered', 'permission_default', 'permission_denied', 'unsupported']
        && data.fcmPushStatus in ['sent', 'failed', 'skipped_no_token']
        && (!('fcmErrorReason' in data) || (data.fcmErrorReason is string && data.fcmErrorReason.size() <= 400))
        && data.read is bool
        && data.isDemo == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProfilePhoto(data) {
      return data.keys().hasAll(['ownerUid', 'subjectId', 'role', 'mimeType', 'sizeBytes', 'photoData', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'subjectId', 'role', 'mimeType', 'sizeBytes', 'photoData', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerUid)
        && isValidId(data.subjectId)
        && data.role in ['worker', 'customer']
        && data.mimeType in ['image/jpeg', 'image/png', 'image/webp']
        && data.sizeBytes is number && data.sizeBytes > 0 && data.sizeBytes <= 5242880
        && data.photoData is string && data.photoData.size() >= 30 && data.photoData.size() <= 480000
        && data.photoData[0:11] == 'data:image/'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAcceptedCustomerPhoto(data) {
      return data.keys().hasAll(['ownerUid', 'workerUid', 'sourceType', 'sourceId', 'photoData', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'workerUid', 'sourceType', 'sourceId', 'photoData', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerUid)
        && isValidId(data.workerUid)
        && data.sourceType in ['job_application', 'demo_work_order']
        && isValidId(data.sourceId)
        && data.photoData is string && data.photoData.size() >= 30 && data.photoData.size() <= 480000
        && data.photoData[0:11] == 'data:image/'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isAcceptedJobGrantValid(data) {
      return (
        data.sourceType == 'job_application'
        && exists(/databases/$(database)/documents/applications/$(data.sourceId))
        && get(/databases/$(database)/documents/applications/$(data.sourceId)).data.employerUid == data.ownerUid
        && get(/databases/$(database)/documents/applications/$(data.sourceId)).data.workerUid == data.workerUid
        && get(/databases/$(database)/documents/applications/$(data.sourceId)).data.status in ['accepted', 'work_completed']
      ) || (
        data.sourceType == 'demo_work_order'
        && exists(/databases/$(database)/documents/demo_work_orders/$(data.sourceId))
        && get(/databases/$(database)/documents/demo_work_orders/$(data.sourceId)).data.ownerUid == data.ownerUid
        && get(/databases/$(database)/documents/demo_work_orders/$(data.sourceId)).data.acceptedWorkerOwnerUid == data.workerUid
        && get(/databases/$(database)/documents/demo_work_orders/$(data.sourceId)).data.status in ['accepted', 'customer_confirmed', 'in_progress', 'completed', 'closed']
      );
    }

    function isValidMobileUniquenessLock(data) {
      return data.keys().hasAll(['ownerUid', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'role', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerUid)
        && data.role in ['worker', 'employer']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNotificationRecord(data) {
      return data.keys().hasAll([
          'recipientUid', 'recipientRole', 'isDemo', 'category', 'title', 'body',
          'language', 'targetRoute', 'dedupeKey', 'deliveryStatus', 'read',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'recipientUid', 'recipientRole', 'senderUid', 'senderName', 'isDemo',
          'category', 'eventType', 'toneType', 'dealStatus', 'title', 'body', 'voiceScript',
          'approxLocationLabel', 'distanceKm', 'customerName', 'jobCategory',
          'playSound', 'speakVoice', 'metadataLabel',
          'language', 'targetRoute', 'targetJobId', 'targetApplicationId',
          'targetDemoJobId', 'dedupeKey', 'deliveryStatus', 'errorMessage',
          'read', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.recipientUid)
        && data.recipientRole in ['worker', 'employer', 'admin', 'demo_worker']
        && (!('senderUid' in data) || isValidId(data.senderUid))
        && (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 140))
        && data.isDemo is bool
        && data.category in ['matchingJobs', 'nearbyJobs', 'applicationUpdates', 'bookingNotifications', 'announcements']
        && (!('eventType' in data) || (data.eventType is string && data.eventType.size() <= 60))
        && (!('toneType' in data) || data.toneType in ['new_job', 'new_offer', 'deal_accepted', 'deal_completed', 'deal_cancelled', 'general'])
        && (!('dealStatus' in data) || isValidDealStatus(data.dealStatus))
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 160
        && data.body is string && data.body.size() >= 2 && data.body.size() <= 500
        && (!('voiceScript' in data) || (data.voiceScript is string && data.voiceScript.size() <= 700))
        && (!('approxLocationLabel' in data) || (data.approxLocationLabel is string && data.approxLocationLabel.size() <= 160))
        && (!('distanceKm' in data) || (data.distanceKm is number && data.distanceKm >= 0 && data.distanceKm <= 5000))
        && (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 160))
        && (!('jobCategory' in data) || (data.jobCategory is string && data.jobCategory.size() <= 80))
        && (!('playSound' in data) || data.playSound is bool)
        && (!('speakVoice' in data) || data.speakVoice is bool)
        && (!('metadataLabel' in data) || (data.metadataLabel is string && data.metadataLabel.size() <= 240))
        && data.language in ['en', 'hi', 'mr']
        && data.targetRoute is string && data.targetRoute.size() >= 2 && data.targetRoute.size() <= 60
        && (!('targetJobId' in data) || isValidId(data.targetJobId))
        && (!('targetApplicationId' in data) || isValidId(data.targetApplicationId))
        && (!('targetDemoJobId' in data) || isValidId(data.targetDemoJobId))
        && isValidId(data.dedupeKey)
        && data.deliveryStatus in ['sent', 'failed', 'in_app_only']
        && (!('errorMessage' in data) || (data.errorMessage is string && data.errorMessage.size() <= 400))
        && data.read is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function canNotifyOnDealContext(data) {
      return (
        'targetApplicationId' in data
        && exists(/databases/$(database)/documents/applications/$(data.targetApplicationId))
        && (
          (
            get(/databases/$(database)/documents/applications/$(data.targetApplicationId)).data.employerUid == request.auth.uid
            && get(/databases/$(database)/documents/applications/$(data.targetApplicationId)).data.workerUid == data.recipientUid
          ) || (
            get(/databases/$(database)/documents/applications/$(data.targetApplicationId)).data.workerUid == request.auth.uid
            && get(/databases/$(database)/documents/applications/$(data.targetApplicationId)).data.employerUid == data.recipientUid
          )
        )
      ) || (
        'targetJobId' in data
        && exists(/databases/$(database)/documents/jobs/$(data.targetJobId))
        && (
          get(/databases/$(database)/documents/jobs/$(data.targetJobId)).data.employerUid == request.auth.uid
          || get(/databases/$(database)/documents/jobs/$(data.targetJobId)).data.employerUid == data.recipientUid
        )
      );
    }

    function isValidDealMessage(data) {
      return data.keys().hasAll([
          'applicationId', 'jobId', 'employerUid', 'workerUid',
          'senderUid', 'senderRole', 'senderName', 'text', 'createdAt'
        ])
        && data.keys().hasOnly([
          'applicationId', 'jobId', 'employerUid', 'workerUid',
          'senderUid', 'senderRole', 'senderName', 'text', 'createdAt'
        ])
        && isValidId(data.applicationId)
        && isValidId(data.jobId)
        && isValidId(data.employerUid)
        && isValidId(data.workerUid)
        && isValidId(data.senderUid)
        && data.senderRole in ['customer', 'worker']
        && data.senderName is string && data.senderName.size() >= 2 && data.senderName.size() <= 120
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 1000
        && data.createdAt is timestamp;
    }

    function isValidDealLocationShare(data) {
      return data.keys().hasAll([
          'applicationId', 'jobId', 'ownerUid', 'authorizedUids',
          'role', 'participantName', 'lat', 'lng', 'accuracyMeters',
          'sharingActive', 'source', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'applicationId', 'jobId', 'ownerUid', 'authorizedUids',
          'role', 'participantName', 'lat', 'lng', 'accuracyMeters',
          'sharingActive', 'source', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.applicationId)
        && isValidId(data.jobId)
        && isValidId(data.ownerUid)
        && data.authorizedUids is list && data.authorizedUids.size() == 2
        && isValidId(data.authorizedUids[0]) && isValidId(data.authorizedUids[1])
        && data.role in ['customer', 'worker']
        && data.participantName is string && data.participantName.size() >= 2 && data.participantName.size() <= 120
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.accuracyMeters is number && data.accuracyMeters >= 0 && data.accuracyMeters <= 200000
        && data.sharingActive is bool
        && data.source in ['gps_watch', 'gps_once', 'manual_pin', 'simulated_move']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isActiveAcceptedDeal(appId) {
      return exists(/databases/$(database)/documents/applications/$(appId))
        && get(/databases/$(database)/documents/applications/$(appId)).data.status == 'accepted'
        && (
          !('dealStatus' in get(/databases/$(database)/documents/applications/$(appId)).data)
          || get(/databases/$(database)/documents/applications/$(appId)).data.dealStatus in [
            'OFFER_ACCEPTED', 'DEAL_CONFIRMED', 'WORKER_ON_THE_WAY', 'WORKER_ARRIVED', 'WORK_IN_PROGRESS'
          ]
        );
    }

    function isValidOrderExactAddress(data) {
      return data.keys().hasAll(['jobId', 'employerUid', 'exactAddress', 'exactLat', 'exactLng', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['jobId', 'employerUid', 'exactAddress', 'landmark', 'exactLat', 'exactLng', 'createdAt', 'updatedAt'])
        && isValidId(data.jobId)
        && isValidId(data.employerUid)
        && data.exactAddress is string && data.exactAddress.size() >= 4 && data.exactAddress.size() <= 300
        && (!('landmark' in data) || (data.landmark is string && data.landmark.size() <= 160))
        && data.exactLat is number && data.exactLat >= -90 && data.exactLat <= 90
        && data.exactLng is number && data.exactLng >= -180 && data.exactLng <= 180
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isConfirmedAssignedWorkerForJob(jobId) {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/jobs/$(jobId))
        && get(/databases/$(database)/documents/jobs/$(jobId)).data.acceptedWorkerUid == request.auth.uid
        && (
          get(/databases/$(database)/documents/jobs/$(jobId)).data.status in ['in_progress', 'completed']
          || (
            'dealStatus' in get(/databases/$(database)/documents/jobs/$(jobId)).data
            && get(/databases/$(database)/documents/jobs/$(jobId)).data.dealStatus in [
              'OFFER_ACCEPTED', 'DEAL_CONFIRMED', 'WORKER_ON_THE_WAY', 'WORKER_ARRIVED', 'WORK_IN_PROGRESS', 'WORK_COMPLETED'
            ]
          )
        );
    }

    function isValidMaskedCallSession(data) {
      return data.keys().hasAll([
          'applicationId', 'jobId', 'employerUid', 'workerUid', 'initiatedByUid',
          'initiatedByRole', 'callerSafeName', 'receiverSafeName', 'maskedBridgeCode',
          'maskedVirtualNumber', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'applicationId', 'jobId', 'employerUid', 'workerUid', 'initiatedByUid',
          'initiatedByRole', 'callerSafeName', 'receiverSafeName', 'maskedBridgeCode',
          'maskedVirtualNumber', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.applicationId)
        && isValidId(data.jobId)
        && isValidId(data.employerUid)
        && isValidId(data.workerUid)
        && isValidId(data.initiatedByUid)
        && data.initiatedByRole in ['customer', 'worker']
        && data.callerSafeName is string && data.callerSafeName.size() >= 1 && data.callerSafeName.size() <= 120
        && data.receiverSafeName is string && data.receiverSafeName.size() >= 1 && data.receiverSafeName.size() <= 120
        && data.maskedBridgeCode is string && data.maskedBridgeCode.size() >= 6 && data.maskedBridgeCode.size() <= 40
        && data.maskedVirtualNumber is string && data.maskedVirtualNumber.size() >= 6 && data.maskedVirtualNumber.size() <= 40
        && data.status in ['ringing', 'connected', 'ended', 'declined']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Collection Rules

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserAccount(incoming())
        && incoming().uid == userId
        && (incoming().role in ['worker', 'employer'] || isAdmin())
        && isValidTimestampOnCreate();
      allow update: if isValidId(userId)
        && isValidUserAccount(incoming())
        && isValidTimestampOnUpdate()
        && incoming().uid == existing().uid
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'preferredLanguage', 'role', 'updatedAt'])
            && incoming().role in ['worker', 'employer']
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(adminId) && isAdmin() && isValidAdminMember(incoming());
      allow delete: if isValidId(adminId) && isAdmin();
    }

    match /publicWorkers/{workerId} {
      allow get: if isValidId(workerId);
      allow list: if true;
      allow create: if isValidId(workerId)
        && isOwner(workerId)
        && isValidPublicWorker(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().verificationStatus == 'pending'
        && (!('registrationPaymentStatus' in incoming()) || incoming().registrationPaymentStatus == 'pending')
        && (!('paidBenefitsActive' in incoming()) || incoming().paidBenefitsActive == false)
        && (!('customProfessionStatus' in incoming()) || incoming().customProfessionStatus == 'pending')
        && !('paymentReceiptNo' in incoming())
        && !('certificateNo' in incoming())
        && incoming().completedJobsCount == 0
        && incoming().ratingAvg == 0
        && isValidTimestampOnCreate();
      allow update: if isValidId(workerId)
        && isVerifiedUser()
        && isValidPublicWorker(incoming())
        && isValidTimestampOnUpdate()
        && incoming().ownerUid == existing().ownerUid
        && (
          isAdmin() ||
          (
            isOwner(existing().ownerUid)
            && incoming().registrationId == existing().registrationId
            && existing().verificationStatus != 'suspended'
            && (!('referralCode' in existing()) || incoming().referralCode == existing().referralCode)
            && (!('customProfessionStatus' in incoming()) || incoming().customProfessionStatus == 'pending' || ('customProfessionStatus' in existing() && incoming().customProfessionStatus == existing().customProfessionStatus))
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'primarySkill', 'skills', 'experienceYears',
              'expectedWage', 'wageUnit', 'preferredWorkType', 'availabilityStatus',
              'state', 'district', 'cityOrVillage', 'approxLat', 'approxLng',
              'languagesKnown', 'gender', 'education', 'isWomenEnterprise', 'photoDocId',
              'preferredLanguage', 'preferredRadiusKm', 'voiceAlertsEnabled', 'referralCode',
              'customProfessionId', 'customProfessionName', 'customProfessionStatus',
              'workDescription', 'workPhotoUrls', 'updatedAt'
            ])
          ) ||
          (
            incoming().registrationId == existing().registrationId
            && existing().verificationStatus != 'suspended'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'ratingAvg', 'completedJobsCount', 'lastRatedApplicationId', 'updatedAt'
            ])
            && 'lastRatedApplicationId' in incoming()
            && isValidId(incoming().lastRatedApplicationId)
            && (!('lastRatedApplicationId' in existing()) || incoming().lastRatedApplicationId != existing().lastRatedApplicationId)
            && exists(/databases/$(database)/documents/applications/$(incoming().lastRatedApplicationId))
            && get(/databases/$(database)/documents/applications/$(incoming().lastRatedApplicationId)).data.employerUid == request.auth.uid
            && get(/databases/$(database)/documents/applications/$(incoming().lastRatedApplicationId)).data.workerUid == workerId
            && get(/databases/$(database)/documents/applications/$(incoming().lastRatedApplicationId)).data.status == 'work_completed'
            && 'workerRating' in get(/databases/$(database)/documents/applications/$(incoming().lastRatedApplicationId)).data
            && incoming().completedJobsCount >= existing().completedJobsCount
            && incoming().completedJobsCount <= existing().completedJobsCount + 1
          )
        );
      allow delete: if isValidId(workerId) && isAdmin();
    }

    match /workerPrivate/{workerId} {
      allow get: if isValidId(workerId) && (isOwner(workerId) || isAdmin());
      allow list: if isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(workerId)
        && isOwner(workerId)
        && isValidWorkerPrivate(incoming())
        && incoming().ownerUid == request.auth.uid
