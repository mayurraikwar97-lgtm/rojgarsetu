        && isValidJob(incoming())
        && isValidTimestampOnUpdate()
        && incoming().employerUid == existing().employerUid
        && (
          isAdmin() ||
          (
            isOwner(existing().employerUid)
            && !(existing().status in ['completed', 'cancelled'])
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'category', 'description', 'workersRequired',
              'requiredSkills', 'state', 'district', 'cityOrVillage',
              'workLocationLabel', 'lat', 'lng', 'jobDate', 'startTime',
              'duration', 'workType', 'offeredWage', 'wageUnit',
