              (
                incoming().status == 'accepted'
                && incoming().acceptedWorkerOwnerUid == request.auth.uid
              )
              || incoming().status in ['requested', 'declined']
            )
          )
          || (
            'acceptedWorkerOwnerUid' in existing()
            && existing().acceptedWorkerOwnerUid == request.auth.uid
            && existing().status in ['accepted', 'customer_confirmed', 'in_progress']
            && incoming().status in ['accepted', 'customer_confirmed', 'in_progress', 'completed']
          )
        );
      allow delete: if isValidId(orderId)
        && isVerifiedUser()
        && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    match /demo_location_shares/{shareId} {
      allow get, list: if isVerifiedUser()
        && (isDemoModeEnabled() || isAdmin())
        && (
          isAdmin()
          || existing().ownerUid == request.auth.uid
          || request.auth.uid in existing().authorizedOwnerUids
        );
      allow create: if isValidId(shareId)
        && isVerifiedUser()
        && (isDemoModeEnabled() || isAdmin())
        && isValidDemoLiveLocationShare(incoming())
        && incoming().ownerUid == request.auth.uid
        && isValidTimestampOnCreate()
        && (
          !incoming().sharingActive ||
          get(/databases/$(database)/documents/demo_work_orders/$(incoming().orderId)).data.status in ['accepted', 'customer_confirmed', 'in_progress']
        );
      allow update: if isValidId(shareId)
        && isVerifiedUser()
        && (isDemoModeEnabled() || isAdmin())
        && isValidDemoLiveLocationShare(incoming())
        && isValidTimestampOnUpdate()
        && incoming().ownerUid == existing().ownerUid
        && incoming().orderId == existing().orderId
        && (
          isAdmin()
          || isOwner(existing().ownerUid)
          || (
            request.auth.uid in existing().authorizedOwnerUids
            && incoming().sharingActive == false
            && incoming().lat == existing().lat
            && incoming().lng == existing().lng
          )
        )
        && (
          !incoming().sharingActive ||
          get(/databases/$(database)/documents/demo_work_orders/$(incoming().orderId)).data.status in ['accepted', 'customer_confirmed', 'in_progress']
        );
      allow delete: if isValidId(shareId)
        && isVerifiedUser()
        && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    match /demo_notifications/{notifId} {
      allow get, list: if isVerifiedUser()
        && (isDemoModeEnabled() || isAdmin())
        && (
          isAdmin()
          || existing().recipientOwnerUid == request.auth.uid
          || existing().senderOwnerUid == request.auth.uid
        );
      allow create: if isValidId(notifId)
        && isVerifiedUser()
        && (isDemoModeEnabled() || isAdmin())
        && isValidDemoNotificationRecord(incoming())
        && incoming().senderOwnerUid == request.auth.uid
        && incoming().dedupeKey == notifId
        && !exists(/databases/$(database)/documents/demo_notifications/$(notifId))
        && isValidTimestampOnCreate();
      allow update: if isValidId(notifId)
        && isVerifiedUser()
        && (isDemoModeEnabled() || isAdmin())
        && isValidDemoNotificationRecord(incoming())
        && isValidTimestampOnUpdate()
        && incoming().senderOwnerUid == existing().senderOwnerUid
        && incoming().recipientOwnerUid == existing().recipientOwnerUid
        && (
          isAdmin()
          || (
            isOwner(existing().recipientOwnerUid)
            && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt'])
          )
          || (
            isOwner(existing().senderOwnerUid)
            && incoming().diff(existing()).affectedKeys().hasOnly(['fcmPushStatus', 'fcmErrorReason', 'updatedAt'])
          )
        );
      allow delete: if isValidId(notifId)
        && isVerifiedUser()
        && (existing().ownerUid == request.auth.uid || existing().recipientOwnerUid == request.auth.uid || isAdmin());
    }

    match /profilePhotos/{photoId} {
      allow get: if isValidId(photoId)
        && isVerifiedUser()
        && (isOwner(existing().ownerUid) || isAdmin() || existing().role == 'worker');
      allow list: if isVerifiedUser()
        && (existing().ownerUid == request.auth.uid || isAdmin() || existing().role == 'worker');
      allow create: if isValidId(photoId)
        && isVerifiedUser()
        && isOwner(incoming().ownerUid)
        && isValidProfilePhoto(incoming())
        && isValidTimestampOnCreate();
      allow update: if isValidId(photoId)
        && isVerifiedUser()
        && isOwner(existing().ownerUid)
        && isValidProfilePhoto(incoming())
        && isValidTimestampOnUpdate()
        && incoming().ownerUid == existing().ownerUid
        && incoming().subjectId == existing().subjectId
        && incoming().role == existing().role;
      allow delete: if isValidId(photoId)
        && isVerifiedUser()
        && (isOwner(existing().ownerUid) || isAdmin());
    }

    match /acceptedCustomerPhotos/{grantId} {
      allow get: if isValidId(grantId)
        && isVerifiedUser()
        && (isAdmin() || existing().ownerUid == request.auth.uid || existing().workerUid == request.auth.uid);
      allow list: if isVerifiedUser()
        && (isAdmin() || existing().ownerUid == request.auth.uid || existing().workerUid == request.auth.uid);
      allow create: if isValidId(grantId)
        && isVerifiedUser()
        && isOwner(incoming().ownerUid)
        && isValidAcceptedCustomerPhoto(incoming())
        && isAcceptedJobGrantValid(incoming())
        && isValidTimestampOnCreate();
      allow update: if isValidId(grantId)
        && isVerifiedUser()
        && isOwner(existing().ownerUid)
        && incoming().ownerUid == existing().ownerUid
        && incoming().workerUid == existing().workerUid
        && incoming().sourceType == existing().sourceType
        && incoming().sourceId == existing().sourceId
        && isValidAcceptedCustomerPhoto(incoming())
        && isAcceptedJobGrantValid(incoming())
        && isValidTimestampOnUpdate();
      allow delete: if isValidId(grantId)
        && isVerifiedUser()
        && (isOwner(existing().ownerUid) || isAdmin());
    }

    match /mobileUniquenessLocks/{lockId} {
      allow get: if isValidId(lockId) && isVerifiedUser();
      allow list: if isAdmin();
      allow create: if isValidId(lockId)
        && isVerifiedUser()
        && isOwner(incoming().ownerUid)
        && isValidMobileUniquenessLock(incoming())
        && !exists(/databases/$(database)/documents/mobileUniquenessLocks/$(lockId))
        && isValidTimestampOnCreate();
      allow update: if isValidId(lockId)
        && isVerifiedUser()
        && isOwner(existing().ownerUid)
        && incoming().ownerUid == existing().ownerUid
        && isValidMobileUniquenessLock(incoming())
        && isValidTimestampOnUpdate();
      allow delete: if isValidId(lockId)
        && isVerifiedUser()
        && (isOwner(existing().ownerUid) || isAdmin());
    }

    match /dealMessages/{messageId} {
      allow get: if isValidId(messageId)
        && isVerifiedUser()
        && (existing().employerUid == request.auth.uid || existing().workerUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser()
        && (existing().employerUid == request.auth.uid || existing().workerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(messageId)
        && isVerifiedUser()
        && isValidDealMessage(incoming())
        && incoming().senderUid == request.auth.uid
        && incoming().createdAt == request.time
        && (
          (incoming().senderRole == 'customer' && request.auth.uid == incoming().employerUid) ||
          (incoming().senderRole == 'worker' && request.auth.uid == incoming().workerUid)
        )
        && (
          (
            exists(/databases/$(database)/documents/applications/$(incoming().applicationId))
            && get(/databases/$(database)/documents/applications/$(incoming().applicationId)).data.employerUid == incoming().employerUid
            && get(/databases/$(database)/documents/applications/$(incoming().applicationId)).data.workerUid == incoming().workerUid
          ) || (
            exists(/databases/$(database)/documents/jobs/$(incoming().jobId))
            && get(/databases/$(database)/documents/jobs/$(incoming().jobId)).data.employerUid == incoming().employerUid
            && get(/databases/$(database)/documents/jobs/$(incoming().jobId)).data.status in ['open', 'in_progress']
            && exists(/databases/$(database)/documents/publicWorkers/$(incoming().workerUid))
          )
        );
      allow update: if false;
      allow delete: if isValidId(messageId) && isAdmin();
    }

    match /dealLocationShares/{shareId} {
      allow get: if isValidId(shareId)
        && isVerifiedUser()
        && (request.auth.uid in existing().authorizedUids || isAdmin());
      allow list: if isVerifiedUser()
        && (request.auth.uid in existing().authorizedUids || isAdmin());
      allow create: if isValidId(shareId)
        && isVerifiedUser()
        && isValidDealLocationShare(incoming())
        && incoming().ownerUid == request.auth.uid
        && request.auth.uid in incoming().authorizedUids
        && isValidTimestampOnCreate()
        && isActiveAcceptedDeal(incoming().applicationId)
        && get(/databases/$(database)/documents/applications/$(incoming().applicationId)).data.employerUid in incoming().authorizedUids
        && get(/databases/$(database)/documents/applications/$(incoming().applicationId)).data.workerUid in incoming().authorizedUids
        && (
          (incoming().role == 'customer' && request.auth.uid == get(/databases/$(database)/documents/applications/$(incoming().applicationId)).data.employerUid) ||
          (incoming().role == 'worker' && request.auth.uid == get(/databases/$(database)/documents/applications/$(incoming().applicationId)).data.workerUid)
        );
      allow update: if isValidId(shareId)
        && isVerifiedUser()
        && isValidDealLocationShare(incoming())
        && isValidTimestampOnUpdate()
        && incoming().applicationId == existing().applicationId
        && incoming().jobId == existing().jobId
        && incoming().ownerUid == existing().ownerUid
        && incoming().role == existing().role
        && incoming().authorizedUids == existing().authorizedUids
        && (
          isAdmin()
          || (
            isOwner(existing().ownerUid)
            && (!incoming().sharingActive || isActiveAcceptedDeal(existing().applicationId))
          )
          || (
            request.auth.uid in existing().authorizedUids
            && incoming().sharingActive == false
            && incoming().lat == existing().lat
            && incoming().lng == existing().lng
          )
        );
      allow delete: if isValidId(shareId)
        && isVerifiedUser()
        && (isOwner(existing().ownerUid) || isAdmin());
    }

    // ============================================================
    // ADVERTISEMENT & WORKER REFERRAL VALIDATION HELPERS
    // ============================================================

    function isValidReferralConfig(data) {
      return data.keys().hasAll([
          'paidRegistrationEnabled', 'registrationFeeInr', 'referralRewardInr',
          'holdingDays', 'updatedByUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'paidRegistrationEnabled', 'registrationFeeInr', 'referralRewardInr',
          'holdingDays', 'programNoticeEn', 'programNoticeHi', 'programNoticeMr',
          'updatedByUid', 'createdAt', 'updatedAt'
        ])
        && data.paidRegistrationEnabled is bool
        && data.registrationFeeInr is number && data.registrationFeeInr >= 0 && data.registrationFeeInr <= 50000
        && data.referralRewardInr is number && data.referralRewardInr >= 0 && data.referralRewardInr <= 10000
        && data.holdingDays is number && data.holdingDays >= 0 && data.holdingDays <= 90
        && (!('programNoticeEn' in data) || (data.programNoticeEn is string && data.programNoticeEn.size() <= 400))
        && (!('programNoticeHi' in data) || (data.programNoticeHi is string && data.programNoticeHi.size() <= 400))
        && (!('programNoticeMr' in data) || (data.programNoticeMr is string && data.programNoticeMr.size() <= 400))
        && isValidId(data.updatedByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdvertiserProfile(data) {
      return data.keys().hasAll([
          'ownerUid', 'businessName', 'contactPerson', 'mobile', 'businessAddress',
          'state', 'district', 'city', 'businessCategory', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'businessName', 'contactPerson', 'mobile', 'whatsappNumber', 'email',
          'businessAddress', 'state', 'district', 'city', 'businessCategory', 'websiteUrl',
          'status', 'adminNotes', 'reviewedByUid', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerUid)
        && data.businessName is string && data.businessName.size() >= 2 && data.businessName.size() <= 160
        && data.contactPerson is string && data.contactPerson.size() >= 2 && data.contactPerson.size() <= 120
        && data.mobile is string && data.mobile.size() >= 10 && data.mobile.size() <= 20
        && (!('whatsappNumber' in data) || (data.whatsappNumber is string && data.whatsappNumber.size() <= 20))
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && data.businessAddress is string && data.businessAddress.size() >= 4 && data.businessAddress.size() <= 300
        && data.state is string && data.state.size() >= 2 && data.state.size() <= 80
        && data.district is string && data.district.size() >= 2 && data.district.size() <= 80
        && data.city is string && data.city.size() >= 2 && data.city.size() <= 100
        && data.businessCategory is string && data.businessCategory.size() >= 2 && data.businessCategory.size() <= 80
        && (!('websiteUrl' in data) || (data.websiteUrl is string && data.websiteUrl.size() <= 300))
        && data.status in ['pending', 'approved', 'rejected', 'suspended']
        && (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 500))
        && (!('reviewedByUid' in data) || isValidId(data.reviewedByUid))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdvertisement(data) {
      return data.keys().hasAll([
          'ownerUid', 'advertiserName', 'title', 'description', 'bannerImageUrl',
          'targetCategories', 'targetStates', 'targetDistricts', 'targetCities',
          'allLocations', 'contactAction', 'startDate', 'endDate', 'status',
          'priority', 'dailyImpressionLimit', 'totalImpressionLimit', 'createdByAdmin',
          'impressionsCount', 'uniqueViewsCount', 'clicksCount',
          'callClicksCount', 'whatsappClicksCount', 'websiteClicksCount',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'advertiserId', 'advertiserName', 'title', 'description', 'bannerImageUrl',
          'targetCategories', 'targetStates', 'targetDistricts', 'targetCities', 'targetAreas',
          'allLocations', 'contactAction', 'callNumber', 'whatsappNumber', 'websiteUrl', 'ctaLabel',
          'startDate', 'endDate', 'preferredDurationDays', 'status', 'priority',
          'dailyImpressionLimit', 'totalImpressionLimit', 'budgetInr', 'adminNotes',
          'createdByAdmin', 'approvedByUid', 'impressionsCount', 'uniqueViewsCount',
          'clicksCount', 'callClicksCount', 'whatsappClicksCount', 'websiteClicksCount',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerUid)
        && (!('advertiserId' in data) || isValidId(data.advertiserId))
        && data.advertiserName is string && data.advertiserName.size() >= 2 && data.advertiserName.size() <= 160
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 140
        && data.description is string && data.description.size() >= 5 && data.description.size() <= 400
        && data.bannerImageUrl is string && data.bannerImageUrl.size() >= 5 && data.bannerImageUrl.size() <= 110000
        && data.targetCategories is list && data.targetCategories.size() >= 1 && data.targetCategories.size() <= 15 && data.targetCategories[0] is string
        && data.targetStates is list && data.targetStates.size() <= 20 && (data.targetStates.size() == 0 || data.targetStates[0] is string)
        && data.targetDistricts is list && data.targetDistricts.size() <= 30 && (data.targetDistricts.size() == 0 || data.targetDistricts[0] is string)
        && data.targetCities is list && data.targetCities.size() <= 30 && (data.targetCities.size() == 0 || data.targetCities[0] is string)
        && (!('targetAreas' in data) || (data.targetAreas is list && data.targetAreas.size() <= 30 && (data.targetAreas.size() == 0 || data.targetAreas[0] is string)))
        && data.allLocations is bool
        && data.contactAction in ['call', 'whatsapp', 'website']
        && (!('callNumber' in data) || (data.callNumber is string && data.callNumber.size() <= 20))
        && (!('whatsappNumber' in data) || (data.whatsappNumber is string && data.whatsappNumber.size() <= 20))
        && (!('websiteUrl' in data) || (data.websiteUrl is string && data.websiteUrl.size() <= 300))
        && (!('ctaLabel' in data) || (data.ctaLabel is string && data.ctaLabel.size() <= 40))
        && data.startDate is string && data.startDate.size() >= 8 && data.startDate.size() <= 20
        && data.endDate is string && data.endDate.size() >= 8 && data.endDate.size() <= 20
        && (!('preferredDurationDays' in data) || (data.preferredDurationDays is number && data.preferredDurationDays >= 1 && data.preferredDurationDays <= 730))
        && data.status in ['draft', 'pending', 'approved', 'active', 'paused', 'rejected', 'expired']
        && data.priority is number && data.priority >= 1 && data.priority <= 10
        && data.dailyImpressionLimit is number && data.dailyImpressionLimit >= 0 && data.dailyImpressionLimit <= 10000000
        && data.totalImpressionLimit is number && data.totalImpressionLimit >= 0 && data.totalImpressionLimit <= 100000000
        && (!('budgetInr' in data) || (data.budgetInr is number && data.budgetInr >= 0 && data.budgetInr <= 10000000))
        && (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 500))
        && data.createdByAdmin is bool
        && (!('approvedByUid' in data) || isValidId(data.approvedByUid))
        && data.impressionsCount is number && data.impressionsCount >= 0 && data.impressionsCount <= 100000000
        && data.uniqueViewsCount is number && data.uniqueViewsCount >= 0 && data.uniqueViewsCount <= 100000000
        && data.clicksCount is number && data.clicksCount >= 0 && data.clicksCount <= 100000000
        && data.callClicksCount is number && data.callClicksCount >= 0 && data.callClicksCount <= 100000000
        && data.whatsappClicksCount is number && data.whatsappClicksCount >= 0 && data.whatsappClicksCount <= 100000000
        && data.websiteClicksCount is number && data.websiteClicksCount >= 0 && data.websiteClicksCount <= 100000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdvertisementCategory(data) {
      return data.keys().hasAll(['slug', 'nameEn', 'linkedServiceCategories', 'active', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['slug', 'nameEn', 'nameHi', 'nameMr', 'linkedServiceCategories', 'active', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 64 && data.slug.matches('^[a-z0-9_\\-]+$')
        && data.nameEn is string && data.nameEn.size() >= 2 && data.nameEn.size() <= 100
        && (!('nameHi' in data) || (data.nameHi is string && data.nameHi.size() <= 100))
        && (!('nameMr' in data) || (data.nameMr is string && data.nameMr.size() <= 100))
        && data.linkedServiceCategories is list && data.linkedServiceCategories.size() >= 1 && data.linkedServiceCategories.size() <= 15 && data.linkedServiceCategories[0] is string
        && data.active is bool
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdvertisementCampaign(data) {
      return data.keys().hasAll([
          'advertiserUid', 'advertisementId', 'campaignName', 'budgetInr',
          'paymentStatus', 'startDate', 'endDate', 'status', 'createdByUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'advertiserUid', 'advertisementId', 'campaignName', 'budgetInr',
          'paymentStatus', 'startDate', 'endDate', 'status', 'notes', 'createdByUid', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.advertiserUid)
        && isValidId(data.advertisementId)
        && data.campaignName is string && data.campaignName.size() >= 2 && data.campaignName.size() <= 160
        && data.budgetInr is number && data.budgetInr >= 0 && data.budgetInr <= 10000000
        && data.paymentStatus in ['unpaid', 'paid', 'waived', 'refunded']
        && data.startDate is string && data.startDate.size() >= 8 && data.startDate.size() <= 20
        && data.endDate is string && data.endDate.size() >= 8 && data.endDate.size() <= 20
        && data.status in ['scheduled', 'running', 'paused', 'completed', 'cancelled']
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdvertisementImpression(data) {
      return data.keys().hasAll(['adId', 'advertiserUid', 'category', 'state', 'district', 'placement', 'sessionHash', 'createdAt'])
        && data.keys().hasOnly(['adId', 'advertiserUid', 'category', 'state', 'district', 'placement', 'sessionHash', 'createdAt'])
        && isValidId(data.adId)
        && isValidId(data.advertiserUid)
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && data.state is string && data.state.size() <= 80
        && data.district is string && data.district.size() <= 80
        && data.placement in ['homepage', 'category_selection', 'service_form', 'service_info']
        && data.sessionHash is string && data.sessionHash.size() >= 6 && data.sessionHash.size() <= 64
        && data.createdAt is timestamp;
    }

    function isValidAdvertisementClick(data) {
      return data.keys().hasAll(['adId', 'advertiserUid', 'category', 'state', 'district', 'placement', 'actionType', 'sessionHash', 'createdAt'])
        && data.keys().hasOnly(['adId', 'advertiserUid', 'category', 'state', 'district', 'placement', 'actionType', 'sessionHash', 'createdAt'])
        && isValidId(data.adId)
        && isValidId(data.advertiserUid)
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && data.state is string && data.state.size() <= 80
        && data.district is string && data.district.size() <= 80
        && data.placement in ['homepage', 'category_selection', 'service_form', 'service_info']
        && data.actionType in ['call', 'whatsapp', 'website']
        && data.sessionHash is string && data.sessionHash.size() >= 6 && data.sessionHash.size() <= 64
        && data.createdAt is timestamp;
    }

    function isValidReferralCodeIndex(data) {
      return data.keys().hasAll(['referralCode', 'ownerUid', 'workerName', 'registrationId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['referralCode', 'ownerUid', 'workerName', 'registrationId', 'createdAt', 'updatedAt'])
        && data.referralCode is string && data.referralCode.size() >= 4 && data.referralCode.size() <= 32 && data.referralCode.matches('^[A-Z0-9_\\-]+$')
        && isValidId(data.ownerUid)
        && data.workerName is string && data.workerName.size() >= 2 && data.workerName.size() <= 120
        && data.registrationId is string && data.registrationId.size() >= 5 && data.registrationId.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkerReferral(data) {
      return data.keys().hasAll([
          'referrerUid', 'referrerName', 'referralCode', 'referredUid', 'referredWorkerName',
          'referredRegistrationId', 'referredMobileHash', 'sourceChannel',
          'registrationPaymentStatus', 'registrationFeePaidInr', 'rewardStatus',
          'rewardAmountInr', 'locked', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'referrerUid', 'referrerName', 'referralCode', 'referredUid', 'referredWorkerName',
          'referredRegistrationId', 'referredMobileHash', 'sourceChannel',
          'registrationPaymentStatus', 'registrationFeePaidInr', 'rewardStatus',
          'rewardAmountInr', 'paymentReference', 'fraudFlags', 'adminNotes', 'isSimulation',
          'locked', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.referrerUid)
        && data.referrerName is string && data.referrerName.size() >= 2 && data.referrerName.size() <= 120
        && data.referralCode is string && data.referralCode.size() >= 4 && data.referralCode.size() <= 32 && data.referralCode.matches('^[A-Z0-9_\\-]+$')
        && isValidId(data.referredUid)
        && data.referrerUid != data.referredUid
        && data.referredWorkerName is string && data.referredWorkerName.size() >= 2 && data.referredWorkerName.size() <= 120
        && data.referredRegistrationId is string && data.referredRegistrationId.size() >= 5 && data.referredRegistrationId.size() <= 40
        && data.referredMobileHash is string && data.referredMobileHash.size() >= 8 && data.referredMobileHash.size() <= 128
        && data.sourceChannel in ['url_link', 'manual_code']
        && data.registrationPaymentStatus in ['free_launch', 'payment_pending', 'paid_verified', 'payment_failed', 'refunded', 'cancelled']
        && data.registrationFeePaidInr is number && data.registrationFeePaidInr >= 0 && data.registrationFeePaidInr <= 50000
        && data.rewardStatus in ['free_not_eligible', 'pending_verification', 'approved', 'paid', 'rejected', 'held', 'reversed']
        && data.rewardAmountInr is number && data.rewardAmountInr >= 0 && data.rewardAmountInr <= 10000
        && (!('paymentReference' in data) || (data.paymentReference is string && data.paymentReference.size() <= 120))
        && (!('paymentId' in data) || isValidId(data.paymentId))
        && (!('otpVerified' in data) || data.otpVerified is bool)
        && (!('singleLevelVerified' in data) || data.singleLevelVerified is bool)
        && (!('fraudFlags' in data) || (data.fraudFlags is list && data.fraudFlags.size() <= 10 && (data.fraudFlags.size() == 0 || data.fraudFlags[0] is string)))
        && (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 500))
        && (!('isSimulation' in data) || data.isSimulation is bool)
        && data.locked is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReferralReward(data) {
      return data.keys().hasAll([
          'referralId', 'referrerUid', 'referrerName', 'referredUid', 'referredWorkerName',
          'referralCode', 'registrationFeeInr', 'rewardAmountInr', 'status',
          'eligibilityReason', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'referralId', 'referrerUid', 'referrerName', 'referredUid', 'referredWorkerName',
          'referralCode', 'registrationFeeInr', 'rewardAmountInr', 'status',
          'eligibilityReason', 'paymentId', 'paymentReference', 'payoutId', 'reviewedByUid',
          'adminNotes', 'reversedReason', 'isSimulation', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.referralId)
        && isValidId(data.referrerUid)
        && data.referrerName is string && data.referrerName.size() >= 2 && data.referrerName.size() <= 120
        && isValidId(data.referredUid)
        && data.referrerUid != data.referredUid
        && data.referredWorkerName is string && data.referredWorkerName.size() >= 2 && data.referredWorkerName.size() <= 120
        && data.referralCode is string && data.referralCode.size() >= 4 && data.referralCode.size() <= 32
        && data.registrationFeeInr is number && data.registrationFeeInr >= 0 && data.registrationFeeInr <= 50000
        && data.rewardAmountInr is number && data.rewardAmountInr >= 0 && data.rewardAmountInr <= 10000
        && data.status in ['pending', 'approved', 'paid', 'rejected', 'held', 'reversed']
        && data.eligibilityReason is string && data.eligibilityReason.size() >= 3 && data.eligibilityReason.size() <= 300
        && (!('paymentId' in data) || isValidId(data.paymentId))
        && (!('paymentReference' in data) || (data.paymentReference is string && data.paymentReference.size() <= 120))
        && (!('payoutId' in data) || isValidId(data.payoutId))
        && (!('reviewedByUid' in data) || isValidId(data.reviewedByUid))
        && (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 500))
        && (!('reversedReason' in data) || (data.reversedReason is string && data.reversedReason.size() <= 300))
        && (!('isSimulation' in data) || data.isSimulation is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReferralWallet(data) {
      return data.keys().hasAll([
          'ownerUid', 'referralCode', 'totalReferrals', 'verifiedPaidReferrals',
          'pendingBalanceInr', 'approvedBalanceInr', 'paidBalanceInr', 'totalEarnedInr',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'referralCode', 'totalReferrals', 'verifiedPaidReferrals',
          'pendingReferrals', 'pendingBalanceInr', 'approvedBalanceInr', 'paidBalanceInr',
          'availableBalanceInr', 'pendingWithdrawalInr', 'withdrawnBalanceInr', 'reversedBalanceInr',
          'totalEarnedInr', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerUid)
        && data.referralCode is string && data.referralCode.size() >= 4 && data.referralCode.size() <= 32
        && data.totalReferrals is number && data.totalReferrals >= 0 && data.totalReferrals <= 100000
        && data.verifiedPaidReferrals is number && data.verifiedPaidReferrals >= 0 && data.verifiedPaidReferrals <= 100000
        && (!('pendingReferrals' in data) || (data.pendingReferrals is number && data.pendingReferrals >= 0 && data.pendingReferrals <= 100000))
        && data.pendingBalanceInr is number && data.pendingBalanceInr >= 0 && data.pendingBalanceInr <= 10000000
        && data.approvedBalanceInr is number && data.approvedBalanceInr >= 0 && data.approvedBalanceInr <= 10000000
        && data.paidBalanceInr is number && data.paidBalanceInr >= 0 && data.paidBalanceInr <= 10000000
        && (!('availableBalanceInr' in data) || (data.availableBalanceInr is number && data.availableBalanceInr >= 0 && data.availableBalanceInr <= 10000000))
        && (!('pendingWithdrawalInr' in data) || (data.pendingWithdrawalInr is number && data.pendingWithdrawalInr >= 0 && data.pendingWithdrawalInr <= 10000000))
        && (!('withdrawnBalanceInr' in data) || (data.withdrawnBalanceInr is number && data.withdrawnBalanceInr >= 0 && data.withdrawnBalanceInr <= 10000000))
        && (!('reversedBalanceInr' in data) || (data.reversedBalanceInr is number && data.reversedBalanceInr >= 0 && data.reversedBalanceInr <= 10000000))
        && data.totalEarnedInr is number && data.totalEarnedInr >= 0 && data.totalEarnedInr <= 10000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReferralPayout(data) {
      return data.keys().hasAll([
          'referrerUid', 'referrerName', 'rewardIds', 'amountInr', 'payoutMethod',
          'transactionReference', 'status', 'recordedByUid', 'paidAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'referrerUid', 'referrerName', 'rewardIds', 'amountInr', 'payoutMethod',
          'transactionReference', 'status', 'notes', 'recordedByUid', 'paidAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.referrerUid)
        && data.referrerName is string && data.referrerName.size() >= 2 && data.referrerName.size() <= 120
        && data.rewardIds is list && data.rewardIds.size() >= 1 && data.rewardIds.size() <= 50 && data.rewardIds[0] is string
        && data.amountInr is number && data.amountInr > 0 && data.amountInr <= 1000000
        && data.payoutMethod in ['upi', 'bank_transfer', 'cash_voucher']
        && data.transactionReference is string && data.transactionReference.size() >= 3 && data.transactionReference.size() <= 120
        && data.status in ['recorded_paid', 'reversed']
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && isValidId(data.recordedByUid)
        && data.paidAt is string && data.paidAt.size() >= 8 && data.paidAt.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkerRegistrationPayment(data) {
      return data.keys().hasAll([
          'workerUid', 'workerName', 'workerSkill', 'workerLocation', 'workerMobileMasked',
          'provisionalAppId', 'amountInr', 'paymentMethod', 'status', 'orderRef',
          'utrOrGatewayRef', 'gatewaySignatureVerified', 'refundPolicyAccepted',
          'noEmploymentGuaranteeAccepted', 'otpVerified', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'workerUid', 'workerName', 'workerSkill', 'workerLocation', 'workerMobileMasked',
          'provisionalAppId', 'verifiedWorkerId', 'amountInr', 'paymentMethod', 'status',
          'orderRef', 'utrOrGatewayRef', 'payerUpiOrName', 'gatewayOrderId', 'gatewayPaymentId',
          'gatewaySignatureVerified', 'receiptNo', 'certificateNo', 'refundPolicyAccepted',
          'noEmploymentGuaranteeAccepted', 'otpVerified', 'referredByCode', 'referredByUid',
          'adminNotes', 'verifiedByUid', 'verifiedAtIso', 'refundReference', 'refundReason',
          'refundedAtIso', 'isDemo', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.workerUid)
        && data.workerName is string && data.workerName.size() >= 2 && data.workerName.size() <= 120
        && data.workerSkill is string && data.workerSkill.size() >= 2 && data.workerSkill.size() <= 80
        && data.workerLocation is string && data.workerLocation.size() >= 2 && data.workerLocation.size() <= 160
        && data.workerMobileMasked is string && data.workerMobileMasked.size() >= 6 && data.workerMobileMasked.size() <= 24
        && data.provisionalAppId is string && data.provisionalAppId.size() >= 5 && data.provisionalAppId.size() <= 40
        && (!('verifiedWorkerId' in data) || (data.verifiedWorkerId is string && data.verifiedWorkerId.size() >= 5 && data.verifiedWorkerId.size() <= 40))
        && data.amountInr is number && data.amountInr >= 1 && data.amountInr <= 50000
        && data.paymentMethod in ['gateway', 'upi_qr']
        && data.status in ['pending', 'verified', 'failed', 'refunded']
        && data.orderRef is string && data.orderRef.size() >= 4 && data.orderRef.size() <= 80
        && data.utrOrGatewayRef is string && data.utrOrGatewayRef.size() >= 4 && data.utrOrGatewayRef.size() <= 120
        && (!('payerUpiOrName' in data) || (data.payerUpiOrName is string && data.payerUpiOrName.size() <= 120))
        && (!('gatewayOrderId' in data) || (data.gatewayOrderId is string && data.gatewayOrderId.size() <= 120))
        && (!('gatewayPaymentId' in data) || (data.gatewayPaymentId is string && data.gatewayPaymentId.size() <= 120))
        && data.gatewaySignatureVerified is bool
        && (!('receiptNo' in data) || (data.receiptNo is string && data.receiptNo.size() <= 60))
        && (!('certificateNo' in data) || (data.certificateNo is string && data.certificateNo.size() <= 60))
        && data.refundPolicyAccepted is bool
        && data.noEmploymentGuaranteeAccepted is bool
        && data.otpVerified is bool
        && (!('referredByCode' in data) || (data.referredByCode is string && data.referredByCode.size() <= 32))
        && (!('referredByUid' in data) || isValidId(data.referredByUid))
        && (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 500))
        && (!('verifiedByUid' in data) || isValidId(data.verifiedByUid))
        && (!('verifiedAtIso' in data) || (data.verifiedAtIso is string && data.verifiedAtIso.size() <= 40))
        && (!('refundReference' in data) || (data.refundReference is string && data.refundReference.size() <= 120))
        && (!('refundReason' in data) || (data.refundReason is string && data.refundReason.size() <= 300))
        && (!('refundedAtIso' in data) || (data.refundedAtIso is string && data.refundedAtIso.size() <= 40))
        && (!('isDemo' in data) || data.isDemo is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReferralWithdrawalRequest(data) {
      return data.keys().hasAll([
          'workerUid', 'workerName', 'referralCode', 'amountInr', 'payoutMethod',
          'maskedDestination', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'workerUid', 'workerName', 'referralCode', 'amountInr', 'payoutMethod',
          'maskedDestination', 'status', 'transactionReference', 'adminNotes',
          'reviewedByUid', 'paidAtIso', 'isDemo', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.workerUid)
        && data.workerName is string && data.workerName.size() >= 2 && data.workerName.size() <= 120
        && data.referralCode is string && data.referralCode.size() >= 4 && data.referralCode.size() <= 32
        && data.amountInr is number && data.amountInr >= 50 && data.amountInr <= 500000
        && data.payoutMethod in ['upi', 'bank_transfer']
        && data.maskedDestination is string && data.maskedDestination.size() >= 4 && data.maskedDestination.size() <= 140
        && data.status in ['pending', 'approved', 'paid', 'rejected']
        && (!('transactionReference' in data) || (data.transactionReference is string && data.transactionReference.size() <= 120))
        && (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 500))
        && (!('reviewedByUid' in data) || isValidId(data.reviewedByUid))
        && (!('paidAtIso' in data) || (data.paidAtIso is string && data.paidAtIso.size() <= 40))
        && (!('isDemo' in data) || data.isDemo is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkerPayoutSecret(data) {
      return data.keys().hasAll(['withdrawalId', 'ownerUid', 'payoutMethod', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'withdrawalId', 'ownerUid', 'payoutMethod', 'upiId',
          'accountHolderName', 'accountNumber', 'ifscCode', 'bankName',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.withdrawalId)
        && isValidId(data.ownerUid)
        && data.payoutMethod in ['upi', 'bank_transfer']
        && (!('upiId' in data) || (data.upiId is string && data.upiId.size() <= 100))
        && (!('accountHolderName' in data) || (data.accountHolderName is string && data.accountHolderName.size() <= 120))
        && (!('accountNumber' in data) || (data.accountNumber is string && data.accountNumber.size() <= 40))
        && (!('ifscCode' in data) || (data.ifscCode is string && data.ifscCode.size() <= 20))
        && (!('bankName' in data) || (data.bankName is string && data.bankName.size() <= 100))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFinancialLedgerEntry(data) {
      return data.keys().hasAll([
          'entryType', 'direction', 'amountInr', 'workerUid', 'workerName',
          'referenceId', 'paymentOrUtrRef', 'description', 'recordedByUid',
          'recordedByEmail', 'createdAt'
        ])
        && data.keys().hasOnly([
          'entryType', 'direction', 'amountInr', 'workerUid', 'workerName',
          'referenceId', 'paymentOrUtrRef', 'description', 'recordedByUid',
          'recordedByEmail', 'isDemo', 'createdAt'
        ])
        && data.entryType in [
          'registration_payment', 'registration_refund',
          'referral_reward_credit', 'referral_reward_reversal', 'withdrawal_payout'
        ]
        && data.direction in ['credit', 'debit']
        && data.amountInr is number && data.amountInr > 0 && data.amountInr <= 1000000
        && isValidId(data.workerUid)
        && data.workerName is string && data.workerName.size() >= 2 && data.workerName.size() <= 120
        && isValidId(data.referenceId)
        && data.paymentOrUtrRef is string && data.paymentOrUtrRef.size() >= 2 && data.paymentOrUtrRef.size() <= 120
        && data.description is string && data.description.size() >= 3 && data.description.size() <= 400
        && isValidId(data.recordedByUid)
        && data.recordedByEmail is string && data.recordedByEmail.size() >= 3 && data.recordedByEmail.size() <= 200
        && (!('isDemo' in data) || data.isDemo is bool)
        && data.createdAt is timestamp;
    }

    // ============================================================
    // ADVERTISEMENT COLLECTION RULES
    // ============================================================

    match /advertisers/{advertiserId} {
      allow get: if isValidId(advertiserId)
        && isVerifiedUser()
        && (isOwner(existing().ownerUid) || isAdmin());
      allow list: if isVerifiedUser()
        && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(advertiserId)
        && isVerifiedUser()
        && isValidAdvertiserProfile(incoming())
        && isValidTimestampOnCreate()
        && (
          isAdmin() ||
          (
            isOwner(advertiserId)
            && incoming().ownerUid == request.auth.uid
            && incoming().status == 'pending'
          )
        );
      allow update: if isValidId(advertiserId)
        && isVerifiedUser()
        && isValidAdvertiserProfile(incoming())
        && isValidTimestampOnUpdate()
        && incoming().ownerUid == existing().ownerUid
        && (
          isAdmin() ||
          (
            isOwner(existing().ownerUid)
            && existing().status != 'suspended'
            && incoming().status == existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'businessName', 'contactPerson', 'mobile', 'whatsappNumber', 'email',
              'businessAddress', 'state', 'district', 'city', 'businessCategory',
              'websiteUrl', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(advertiserId) && isAdmin();
    }

    match /advertisements/{adId} {
      allow get: if isValidId(adId) && (
        existing().status == 'active'
        || (isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin()))
      );
      allow list: if existing().status == 'active'
        || (isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin()));
      allow create: if isValidId(adId)
        && isVerifiedUser()
        && isValidAdvertisement(incoming())
        && isValidTimestampOnCreate()
        && (
          isAdmin() ||
          (
            incoming().ownerUid == request.auth.uid
            && incoming().createdByAdmin == false
            && incoming().status in ['draft', 'pending']
            && incoming().priority == 5
            && incoming().impressionsCount == 0
            && incoming().uniqueViewsCount == 0
            && incoming().clicksCount == 0
            && incoming().callClicksCount == 0
            && incoming().whatsappClicksCount == 0
            && incoming().websiteClicksCount == 0
          )
        );
      allow update: if isValidId(adId)
        && isValidAdvertisement(incoming())
        && isValidTimestampOnUpdate()
        && incoming().ownerUid == existing().ownerUid
        && (
          isAdmin()
          || (
            isVerifiedUser()
            && isOwner(existing().ownerUid)
            && existing().status in ['draft', 'pending', 'paused', 'rejected']
            && incoming().status in ['draft', 'pending']
            && incoming().createdByAdmin == existing().createdByAdmin
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'advertiserName', 'title', 'description', 'bannerImageUrl',
              'targetCategories', 'targetStates', 'targetDistricts', 'targetCities', 'targetAreas',
              'allLocations', 'contactAction', 'callNumber', 'whatsappNumber', 'websiteUrl', 'ctaLabel',
              'startDate', 'endDate', 'preferredDurationDays', 'status', 'updatedAt'
            ])
          )
          || (
            // Anonymous or signed-in aggregate impression/click counter increment ONLY on active ads (max +1 per event)
            existing().status == 'active'
            && incoming().status == 'active'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'impressionsCount', 'uniqueViewsCount', 'clicksCount',
              'callClicksCount', 'whatsappClicksCount', 'websiteClicksCount', 'updatedAt'
            ])
            && incoming().impressionsCount >= existing().impressionsCount
            && incoming().impressionsCount <= existing().impressionsCount + 1
            && incoming().uniqueViewsCount >= existing().uniqueViewsCount
            && incoming().uniqueViewsCount <= existing().uniqueViewsCount + 1
            && incoming().clicksCount >= existing().clicksCount
            && incoming().clicksCount <= existing().clicksCount + 1
            && incoming().callClicksCount >= existing().callClicksCount
            && incoming().callClicksCount <= existing().callClicksCount + 1
            && incoming().whatsappClicksCount >= existing().whatsappClicksCount
            && incoming().whatsappClicksCount <= existing().whatsappClicksCount + 1
            && incoming().websiteClicksCount >= existing().websiteClicksCount
            && incoming().websiteClicksCount <= existing().websiteClicksCount + 1
          )
        );
      allow delete: if isValidId(adId) && isAdmin();
    }

    match /advertisementCategories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create: if isValidId(categoryId)
        && isAdmin()
        && isValidAdvertisementCategory(incoming())
        && incoming().createdByUid == request.auth.uid
        && isValidTimestampOnCreate();
      allow update: if isValidId(categoryId)
        && isAdmin()
        && isValidAdvertisementCategory(incoming())
        && isValidTimestampOnUpdate();
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    match /advertisementCampaigns/{campaignId} {
      allow get: if isValidId(campaignId)
        && isVerifiedUser()
        && (existing().advertiserUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser()
        && (existing().advertiserUid == request.auth.uid || isAdmin());
      allow create: if isValidId(campaignId)
        && isAdmin()
        && isValidAdvertisementCampaign(incoming())
        && incoming().createdByUid == request.auth.uid
        && isValidTimestampOnCreate();
      allow update: if isValidId(campaignId)
        && isAdmin()
        && isValidAdvertisementCampaign(incoming())
        && isValidTimestampOnUpdate();
      allow delete: if isValidId(campaignId) && isAdmin();
    }

    match /advertisementImpressions/{impressionId} {
      allow get: if isValidId(impressionId)
        && isVerifiedUser()
        && (existing().advertiserUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser()
        && (existing().advertiserUid == request.auth.uid || isAdmin());
      allow create: if isValidId(impressionId)
        && isValidAdvertisementImpression(incoming())
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/advertisements/$(incoming().adId))
        && get(/databases/$(database)/documents/advertisements/$(incoming().adId)).data.status == 'active'
        && get(/databases/$(database)/documents/advertisements/$(incoming().adId)).data.ownerUid == incoming().advertiserUid;
      allow update: if false;
      allow delete: if isValidId(impressionId) && isAdmin();
    }

    match /advertisementClicks/{clickId} {
      allow get: if isValidId(clickId)
        && isVerifiedUser()
        && (existing().advertiserUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser()
        && (existing().advertiserUid == request.auth.uid || isAdmin());
      allow create: if isValidId(clickId)
        && isValidAdvertisementClick(incoming())
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/advertisements/$(incoming().adId))
        && get(/databases/$(database)/documents/advertisements/$(incoming().adId)).data.status == 'active'
        && get(/databases/$(database)/documents/advertisements/$(incoming().adId)).data.ownerUid == incoming().advertiserUid;
      allow update: if false;
      allow delete: if isValidId(clickId) && isAdmin();
    }

    // ============================================================
    // WORKER REFERRAL & REWARD COLLECTION RULES
    // ============================================================

    match /referralCodeIndex/{codeId} {
      allow get: if isValidId(codeId);
      allow list: if isAdmin();
      allow create: if isValidId(codeId)
        && isVerifiedUser()
        && isValidReferralCodeIndex(incoming())
        && incoming().referralCode == codeId
        && !exists(/databases/$(database)/documents/referralCodeIndex/$(codeId))
        && isValidTimestampOnCreate()
        && (isAdmin() || incoming().ownerUid == request.auth.uid);
      allow update: if isValidId(codeId)
        && isAdmin()
        && isValidReferralCodeIndex(incoming())
        && isValidTimestampOnUpdate();
      allow delete: if isValidId(codeId) && isAdmin();
    }

    match /workerReferrals/{referralId} {
      allow get: if isValidId(referralId)
        && isVerifiedUser()
        && (
          isAdmin()
          || existing().referrerUid == request.auth.uid
          || existing().referredUid == request.auth.uid
        );
      allow list: if isVerifiedUser()
        && (
          isAdmin()
          || existing().referrerUid == request.auth.uid
          || existing().referredUid == request.auth.uid
        );
      allow create: if isValidId(referralId)
        && isVerifiedUser()
        && isValidWorkerReferral(incoming())
        && isValidTimestampOnCreate()
        && (
          isAdmin() ||
          (
            // One locked single-level referral record per newly registered worker, doc ID == referredUid, no self-referral, ₹0 until verified
            referralId == request.auth.uid
            && incoming().referredUid == request.auth.uid
            && incoming().referrerUid != request.auth.uid
            && incoming().locked == true
            && incoming().registrationPaymentStatus in ['free_launch', 'payment_pending']
            && incoming().registrationFeePaidInr == 0
            && incoming().rewardStatus in ['free_not_eligible', 'pending_verification']
            && incoming().rewardAmountInr == 0
            && (!('isSimulation' in incoming()) || incoming().isSimulation == false)
            && !exists(/databases/$(database)/documents/workerReferrals/$(referralId))
            && exists(/databases/$(database)/documents/referralCodeIndex/$(incoming().referralCode))
            && get(/databases/$(database)/documents/referralCodeIndex/$(incoming().referralCode)).data.ownerUid == incoming().referrerUid
          )
        );
      // Only Admin can transition payment/reward status; referral ownership (referrerUid, referredUid, referralCode) is permanently locked
      allow update: if isValidId(referralId)
        && isAdmin()
        && isValidWorkerReferral(incoming())
        && isValidTimestampOnUpdate()
        && incoming().referrerUid == existing().referrerUid
        && incoming().referredUid == existing().referredUid
        && incoming().referralCode == existing().referralCode;
      allow delete: if isValidId(referralId) && isAdmin();
    }

    match /referralRewards/{rewardId} {
      allow get: if isValidId(rewardId)
        && isVerifiedUser()
        && (isAdmin() || existing().referrerUid == request.auth.uid);
      allow list: if isVerifiedUser()
        && (isAdmin() || existing().referrerUid == request.auth.uid);
      allow create: if isValidId(rewardId)
        && isAdmin()
        && isValidReferralReward(incoming())
        && isValidTimestampOnCreate();
      allow update: if isValidId(rewardId)
        && isAdmin()
        && isValidReferralReward(incoming())
        && isValidTimestampOnUpdate()
        && incoming().referralId == existing().referralId
        && incoming().referrerUid == existing().referrerUid
        && incoming().referredUid == existing().referredUid;
      allow delete: if isValidId(rewardId) && isAdmin();
    }

    match /referralWallets/{walletId} {
      allow get: if isValidId(walletId)
        && isVerifiedUser()
        && (isAdmin() || isOwner(walletId));
      allow list: if isVerifiedUser()
        && (isAdmin() || existing().ownerUid == request.auth.uid);
      allow create: if isValidId(walletId)
        && isVerifiedUser()
        && isValidReferralWallet(incoming())
        && isValidTimestampOnCreate()
        && (
          isAdmin() ||
          (
            // Worker can initialize their own empty ₹0 wallet once
            isOwner(walletId)
            && incoming().ownerUid == request.auth.uid
            && incoming().totalReferrals == 0
            && incoming().verifiedPaidReferrals == 0
            && incoming().pendingBalanceInr == 0
            && incoming().approvedBalanceInr == 0
            && incoming().paidBalanceInr == 0
            && incoming().totalEarnedInr == 0
          )
        );
      allow update: if isValidId(walletId)
        && isAdmin()
        && isValidReferralWallet(incoming())
        && isValidTimestampOnUpdate()
        && incoming().ownerUid == existing().ownerUid;
      allow delete: if isValidId(walletId) && isAdmin();
    }

    match /referralPayouts/{payoutId} {
      allow get: if isValidId(payoutId)
        && isVerifiedUser()
        && (isAdmin() || existing().referrerUid == request.auth.uid);
      allow list: if isVerifiedUser()
        && (isAdmin() || existing().referrerUid == request.auth.uid);
      allow create: if isValidId(payoutId)
        && isAdmin()
        && isValidReferralPayout(incoming())
        && incoming().recordedByUid == request.auth.uid
        && isValidTimestampOnCreate();
      allow update: if isValidId(payoutId)
        && isAdmin()
        && isValidReferralPayout(incoming())
        && isValidTimestampOnUpdate()
        && incoming().referrerUid == existing().referrerUid;
      allow delete: if isValidId(payoutId) && isAdmin();
    }

    // ============================================================
    // CUSTOMER PRIVACY VAULT & MASKED CALLING RULES
    // ============================================================

    match /orderExactAddresses/{jobId} {
      allow get: if isValidId(jobId)
        && isVerifiedUser()
        && (
          isAdmin()
          || existing().employerUid == request.auth.uid
          || isConfirmedAssignedWorkerForJob(jobId)
        );
      allow list: if isVerifiedUser()
        && (isAdmin() || existing().employerUid == request.auth.uid);
      allow create: if isValidId(jobId)
        && isVerifiedUser()
        && isValidOrderExactAddress(incoming())
        && incoming().jobId == jobId
        && isValidTimestampOnCreate()
        && (isAdmin() || incoming().employerUid == request.auth.uid);
      allow update: if isValidId(jobId)
        && isVerifiedUser()
        && isValidOrderExactAddress(incoming())
        && isValidTimestampOnUpdate()
        && incoming().jobId == existing().jobId
        && incoming().employerUid == existing().employerUid
        && (isAdmin() || isOwner(existing().employerUid));
      allow delete: if isValidId(jobId)
        && (isAdmin() || isOwner(existing().employerUid));
    }

    match /maskedCallSessions/{sessionId} {
      allow get: if isValidId(sessionId)
        && isVerifiedUser()
        && (
          isAdmin()
          || existing().employerUid == request.auth.uid
          || existing().workerUid == request.auth.uid
        );
      allow list: if isVerifiedUser()
        && (
          isAdmin()
          || existing().employerUid == request.auth.uid
          || existing().workerUid == request.auth.uid
        );
      allow create: if isValidId(sessionId)
        && isVerifiedUser()
        && isValidMaskedCallSession(incoming())
        && isValidTimestampOnCreate()
        && isActiveAcceptedDeal(incoming().applicationId)
        && (
          isAdmin()
          || (
            incoming().initiatedByUid == request.auth.uid
            && (
              (incoming().initiatedByRole == 'customer' && incoming().employerUid == request.auth.uid)
              || (incoming().initiatedByRole == 'worker' && incoming().workerUid == request.auth.uid)
            )
            && get(/databases/$(database)/documents/applications/$(incoming().applicationId)).data.employerUid == incoming().employerUid
            && get(/databases/$(database)/documents/applications/$(incoming().applicationId)).data.workerUid == incoming().workerUid
          )
        );
      allow update: if isValidId(sessionId)
        && isVerifiedUser()
        && isValidMaskedCallSession(incoming())
        && isValidTimestampOnUpdate()
        && incoming().applicationId == existing().applicationId
        && incoming().jobId == existing().jobId
        && incoming().employerUid == existing().employerUid
        && incoming().workerUid == existing().workerUid
        && incoming().initiatedByUid == existing().initiatedByUid
        && incoming().initiatedByRole == existing().initiatedByRole
        && incoming().maskedBridgeCode == existing().maskedBridgeCode
        && incoming().maskedVirtualNumber == existing().maskedVirtualNumber
        && (
          isAdmin()
          || (
            (existing().employerUid == request.auth.uid || existing().workerUid == request.auth.uid)
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isValidId(sessionId) && isAdmin();
    }

    // ============================================================
    // WORKER ₹250 REGISTRATION PAYMENTS, WITHDRAWALS & AUDIT LEDGER
    // ============================================================

    match /workerRegistrationPayments/{paymentId} {
      allow get: if isValidId(paymentId)
        && isVerifiedUser()
        && (isAdmin() || existing().workerUid == request.auth.uid);
      allow list: if isVerifiedUser()
        && (isAdmin() || existing().workerUid == request.auth.uid);
      allow create: if isValidId(paymentId)
        && isVerifiedUser()
        && isValidWorkerRegistrationPayment(incoming())
        && isValidTimestampOnCreate()
        && (
          isAdmin() ||
          (
            // Workers can ONLY submit a pending ₹250 payment record — never self-verify!
            paymentId == request.auth.uid
            && incoming().workerUid == request.auth.uid
            && incoming().amountInr == 250
            && incoming().status == 'pending'
            && incoming().gatewaySignatureVerified == false
            && !('verifiedWorkerId' in incoming())
            && !('receiptNo' in incoming())
            && !('certificateNo' in incoming())
            && !('verifiedByUid' in incoming())
            && !('refundReference' in incoming())
            && (!('isDemo' in incoming()) || incoming().isDemo == false)
          )
        );
      allow update: if isValidId(paymentId)
        && isVerifiedUser()
        && isValidWorkerRegistrationPayment(incoming())
        && isValidTimestampOnUpdate()
        && incoming().workerUid == existing().workerUid
        && (
          isAdmin() ||
          (
            // Worker can resubmit UTR/payment proof ONLY while pending or failed; status remains strictly pending
            isOwner(existing().workerUid)
            && existing().status in ['pending', 'failed']
            && incoming().status == 'pending'
            && incoming().amountInr == existing().amountInr
            && incoming().gatewaySignatureVerified == false
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'paymentMethod', 'orderRef', 'utrOrGatewayRef', 'payerUpiOrName',
              'gatewayOrderId', 'gatewayPaymentId', 'status', 'refundPolicyAccepted',
              'noEmploymentGuaranteeAccepted', 'otpVerified', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(paymentId) && isAdmin();
    }

    match /referralWithdrawals/{withdrawalId} {
      allow get: if isValidId(withdrawalId)
        && isVerifiedUser()
        && (isAdmin() || existing().workerUid == request.auth.uid);
      allow list: if isVerifiedUser()
        && (isAdmin() || existing().workerUid == request.auth.uid);
      allow create: if isValidId(withdrawalId)
        && isVerifiedUser()
        && isValidReferralWithdrawalRequest(incoming())
        && isValidTimestampOnCreate()
        && (
          isAdmin() ||
          (
            incoming().workerUid == request.auth.uid
            && incoming().status == 'pending'
            && !('transactionReference' in incoming())
            && !('reviewedByUid' in incoming())
            && !('paidAtIso' in incoming())
            && (!('isDemo' in incoming()) || incoming().isDemo == false)
          )
        );
      allow update: if isValidId(withdrawalId)
        && isAdmin()
        && isValidReferralWithdrawalRequest(incoming())
        && isValidTimestampOnUpdate()
        && incoming().workerUid == existing().workerUid
        && incoming().amountInr == existing().amountInr;
      allow delete: if isValidId(withdrawalId) && isAdmin();
    }

    match /workerPayoutSecrets/{withdrawalId} {
      // Strictly private banking / UPI payout details: ONLY the owning worker and authorized Admin
      allow get: if isValidId(withdrawalId)
        && isVerifiedUser()
        && (isAdmin() || existing().ownerUid == request.auth.uid);
      allow list: if isVerifiedUser()
        && (isAdmin() || existing().ownerUid == request.auth.uid);
      allow create: if isValidId(withdrawalId)
        && isVerifiedUser()
        && isValidWorkerPayoutSecret(incoming())
        && incoming().withdrawalId == withdrawalId
        && isValidTimestampOnCreate()
        && (isAdmin() || incoming().ownerUid == request.auth.uid);
      allow update: if isValidId(withdrawalId)
        && isAdmin()
        && isValidWorkerPayoutSecret(incoming())
        && isValidTimestampOnUpdate()
        && incoming().ownerUid == existing().ownerUid
        && incoming().withdrawalId == existing().withdrawalId;
      allow delete: if isValidId(withdrawalId) && isAdmin();
    }

    match /financialLedger/{entryId} {
      // Auditable immutable financial transaction ledger — Admin only
      allow get: if isValidId(entryId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(entryId)
        && isAdmin()
        && isValidFinancialLedgerEntry(incoming())
        && incoming().recordedByUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(entryId) && isAdmin();
    }

    match /customProfessions/{professionId} {
      // Unverified custom professions are NEVER published publicly; only approved categories,
      // the submitting worker, and authorized Admins may read them.
      allow get: if isValidId(professionId)
        && (
          existing().status == 'approved' ||
          (isVerifiedUser() && existing().createdByUid == request.auth.uid) ||
          isAdmin()
        );
      allow list: if existing().status == 'approved'
        || (isVerifiedUser() && existing().createdByUid == request.auth.uid)
        || isAdmin();
      allow create: if isValidId(professionId)
        && isVerifiedUser()
        && isValidCustomProfession(incoming())
        && incoming().slug == professionId
        && isValidTimestampOnCreate()
        && (
          isAdmin() ||
          (
            incoming().createdByUid == request.auth.uid
            && incoming().status == 'pending'
            && incoming().source == 'worker_submission'
            && !('approvedByUid' in incoming())
            && !('adminNotes' in incoming())
            && incoming().usageCount <= 1
          )
        );
      allow update: if isValidId(professionId)
        && isAdmin()
        && isValidCustomProfession(incoming())
        && incoming().slug == existing().slug
        && isValidTimestampOnUpdate();
      allow delete: if isValidId(professionId) && isAdmin();
    }
  }
}
