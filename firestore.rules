    }

    function isValidProfilePhoto(data) {
      return data.keys().hasAll(['ownerUid', 'subjectId', 'role', 'mimeType', 'sizeBytes', 'photoData', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'subjectId', 'role', 'mimeType', 'sizeBytes', 'photoData', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerUid)
        && isValidId(data.subjectId)
        && data.role in ['worker', 'customer']
        && data.mimeType in ['image/jpeg', 'image/png', 'image/webp']
        && data.sizeBytes is number && data.sizeBytes > 0 && data.sizeBytes <= 5242880
        && data.photoData is string && data.photoData.size() >= 30 && data.photoData.size() <= 480000
        && data.photoData[0:11] == 'data:image/'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAcceptedCustomerPhoto(data) {
      return data.keys().hasAll(['ownerUid', 'workerUid', 'sourceType', 'sourceId', 'photoData', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'workerUid', 'sourceType', 'sourceId', 'photoData', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerUid)
        && isValidId(data.workerUid)
        && data.sourceType in ['job_application', 'demo_work_order']
        && isValidId(data.sourceId)
        && data.photoData is string && data.photoData.size() >= 30 && data.photoData.size() <= 480000
        && data.photoData[0:11] == 'data:image/'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isAcceptedJobGrantValid(data) {
      return (
        data.sourceType == 'job_application'
        && exists(/databases/$(database)/documents/applications/$(data.sourceId))
        && get(/databases/$(database)/documents/applications/$(data.sourceId)).data.employerUid == data.ownerUid
        && get(/databases/$(database)/documents/applications/$(data.sourceId)).data.workerUid == data.workerUid
        && get(/databases/$(database)/documents/applications/$(data.sourceId)).data.status in ['accepted', 'work_completed']
      ) || (
        data.sourceType == 'demo_work_order'
        && exists(/databases/$(database)/documents/demo_work_orders/$(data.sourceId))
        && get(/databases/$(database)/documents/demo_work_orders/$(data.sourceId)).data.ownerUid == data.ownerUid
        && get(/databases/$(database)/documents/demo_work_orders/$(data.sourceId)).data.acceptedWorkerOwnerUid == data.workerUid
        && get(/databases/$(database)/documents/demo_work_orders/$(data.sourceId)).data.status in ['accepted', 'customer_confirmed', 'in_progress', 'completed', 'closed']
      );
    }

    function isValidMobileUniquenessLock(data) {
      return data.keys().hasAll(['ownerUid', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'role', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerUid)
        && data.role in ['worker', 'employer']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNotificationRecord(data) {
      return data.keys().hasAll([
          'recipientUid', 'recipientRole', 'isDemo', 'category', 'title', 'body',
          'language', 'targetRoute', 'dedupeKey', 'deliveryStatus', 'read',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'recipientUid', 'recipientRole', 'senderUid', 'senderName', 'isDemo',
          'category', 'eventType', 'dealStatus', 'title', 'body', 'voiceScript',
          'approxLocationLabel', 'distanceKm', 'customerName', 'jobCategory',
          'playSound', 'speakVoice', 'metadataLabel',
          'language', 'targetRoute', 'targetJobId', 'targetApplicationId',
          'targetDemoJobId', 'dedupeKey', 'deliveryStatus', 'errorMessage',
          'read', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.recipientUid)
        && data.recipientRole in ['worker', 'employer', 'admin', 'demo_worker']
        && (!('senderUid' in data) || isValidId(data.senderUid))
        && (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 140))
        && data.isDemo is bool
        && data.category in ['matchingJobs', 'nearbyJobs', 'applicationUpdates', 'bookingNotifications', 'announcements']
        && (!('eventType' in data) || (data.eventType is string && data.eventType.size() <= 60))
        && (!('dealStatus' in data) || isValidDealStatus(data.dealStatus))
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 160
        && data.body is string && data.body.size() >= 2 && data.body.size() <= 500
        && (!('voiceScript' in data) || (data.voiceScript is string && data.voiceScript.size() <= 700))
        && (!('approxLocationLabel' in data) || (data.approxLocationLabel is string && data.approxLocationLabel.size() <= 160))
        && (!('distanceKm' in data) || (data.distanceKm is number && data.distanceKm >= 0 && data.distanceKm <= 5000))
        && (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 160))
        && (!('jobCategory' in data) || (data.jobCategory is string && data.jobCategory.size() <= 80))
        && (!('playSound' in data) || data.playSound is bool)
        && (!('speakVoice' in data) || data.speakVoice is bool)
        && (!('metadataLabel' in data) || (data.metadataLabel is string && data.metadataLabel.size() <= 240))
        && data.language in ['en', 'hi', 'mr']
        && data.targetRoute is string && data.targetRoute.size() >= 2 && data.targetRoute.size() <= 60
        && (!('targetJobId' in data) || isValidId(data.targetJobId))
        && (!('targetApplicationId' in data) || isValidId(data.targetApplicationId))
        && (!('targetDemoJobId' in data) || isValidId(data.targetDemoJobId))
        && isValidId(data.dedupeKey)
        && data.deliveryStatus in ['sent', 'failed', 'in_app_only']
        && (!('errorMessage' in data) || (data.errorMessage is string && data.errorMessage.size() <= 400))
        && data.read is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function canNotifyOnDealContext(data) {
      return (
        'targetApplicationId' in data
        && exists(/databases/$(database)/documents/applications/$(data.targetApplicationId))
        && (
          (
            get(/databases/$(database)/documents/applications/$(data.targetApplicationId)).data.employerUid == request.auth.uid
            && get(/databases/$(database)/documents/applications/$(data.targetApplicationId)).data.workerUid == data.recipientUid
          ) || (
            get(/databases/$(database)/documents/applications/$(data.targetApplicationId)).data.workerUid == request.auth.uid
            && get(/databases/$(database)/documents/applications/$(data.targetApplicationId)).data.employerUid == data.recipientUid
          )
        )
      ) || (
        'targetJobId' in data
        && exists(/databases/$(database)/documents/jobs/$(data.targetJobId))
        && (
          get(/databases/$(database)/documents/jobs/$(data.targetJobId)).data.employerUid == request.auth.uid
          || get(/databases/$(database)/documents/jobs/$(data.targetJobId)).data.employerUid == data.recipientUid
        )
      );
    }

    function isValidDealMessage(data) {
      return data.keys().hasAll([
          'applicationId', 'jobId', 'employerUid', 'workerUid',
          'senderUid', 'senderRole', 'senderName', 'text', 'createdAt'
        ])
        && data.keys().hasOnly([
          'applicationId', 'jobId', 'employerUid', 'workerUid',
          'senderUid', 'senderRole', 'senderName', 'text', 'createdAt'
        ])
        && isValidId(data.applicationId)
        && isValidId(data.jobId)
        && isValidId(data.employerUid)
        && isValidId(data.workerUid)
        && isValidId(data.senderUid)
        && data.senderRole in ['customer', 'worker']
        && data.senderName is string && data.senderName.size() >= 2 && data.senderName.size() <= 120
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 1000
        && data.createdAt is timestamp;
    }

    function isValidDealLocationShare(data) {
      return data.keys().hasAll([
          'applicationId', 'jobId', 'ownerUid', 'authorizedUids',
          'role', 'participantName', 'lat', 'lng', 'accuracyMeters',
          'sharingActive', 'source', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'applicationId', 'jobId', 'ownerUid', 'authorizedUids',
          'role', 'participantName', 'lat', 'lng', 'accuracyMeters',
          'sharingActive', 'source', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.applicationId)
        && isValidId(data.jobId)
        && isValidId(data.ownerUid)
        && data.authorizedUids is list && data.authorizedUids.size() == 2
        && isValidId(data.authorizedUids[0]) && isValidId(data.authorizedUids[1])
        && data.role in ['customer', 'worker']
        && data.participantName is string && data.participantName.size() >= 2 && data.participantName.size() <= 120
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.accuracyMeters is number && data.accuracyMeters >= 0 && data.accuracyMeters <= 200000
        && data.sharingActive is bool
        && data.source in ['gps_watch', 'gps_once', 'manual_pin', 'simulated_move']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isActiveAcceptedDeal(appId) {
      return exists(/databases/$(database)/documents/applications/$(appId))
        && get(/databases/$(database)/documents/applications/$(appId)).data.status == 'accepted'
        && (
          !('dealStatus' in get(/databases/$(database)/documents/applications/$(appId)).data)
          || get(/databases/$(database)/documents/applications/$(appId)).data.dealStatus in ['OFFER_ACCEPTED', 'DEAL_CONFIRMED', 'WORK_IN_PROGRESS']
        );
    }

    // Collection Rules

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserAccount(incoming())
        && incoming().uid == userId
        && (incoming().role in ['worker', 'employer'] || isAdmin())
        && isValidTimestampOnCreate();
      allow update: if isValidId(userId)
        && isValidUserAccount(incoming())
        && isValidTimestampOnUpdate()
        && incoming().uid == existing().uid
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'preferredLanguage', 'role', 'updatedAt'])
            && incoming().role in ['worker', 'employer']
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(adminId) && isAdmin() && isValidAdminMember(incoming());
      allow delete: if isValidId(adminId) && isAdmin();
    }

    match /publicWorkers/{workerId} {
      allow get: if isValidId(workerId);
      allow list: if true;
      allow create: if isValidId(workerId)
        && isOwner(workerId)
        && isValidPublicWorker(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().verificationStatus == 'pending'
        && incoming().completedJobsCount == 0
        && incoming().ratingAvg == 0
        && isValidTimestampOnCreate();
      allow update: if isValidId(workerId)
        && isVerifiedUser()
        && isValidPublicWorker(incoming())
        && isValidTimestampOnUpdate()
        && incoming().ownerUid == existing().ownerUid
        && incoming().registrationId == existing().registrationId
        && (
          isAdmin() ||
          (
            isOwner(existing().ownerUid)
            && existing().verificationStatus != 'suspended'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'primarySkill', 'skills', 'experienceYears',
              'expectedWage', 'wageUnit', 'preferredWorkType', 'availabilityStatus',
              'state', 'district', 'cityOrVillage', 'approxLat', 'approxLng',
              'languagesKnown', 'gender', 'education', 'isWomenEnterprise', 'photoDocId',
              'preferredLanguage', 'preferredRadiusKm', 'voiceAlertsEnabled', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(workerId) && isAdmin();
    }

    match /workerPrivate/{workerId} {
      allow get: if isValidId(workerId) && (isOwner(workerId) || isAdmin());
      allow list: if isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(workerId)
        && isOwner(workerId)
        && isValidWorkerPrivate(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().mobileVerified == true
        && incoming().idVerificationStatus in ['not_submitted', 'voluntary_pending']
        && isValidTimestampOnCreate();
      allow update: if isValidId(workerId)
        && isVerifiedUser()
        && isValidWorkerPrivate(incoming())
        && isValidTimestampOnUpdate()
        && incoming().ownerUid == existing().ownerUid
        && (
          isAdmin() ||
          (
            isOwner(existing().ownerUid)
            && incoming().mobileVerified == true
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName', 'mobile', 'mobileVerified', 'verificationMethod', 'testPinHash',
              'email', 'ageConfirmed', 'preferredWorkLocation', 'liveLocationConsent',
              'privacyConsent', 'idVerificationStatus', 'certificateNotes', 'photoUrl',
              'photoDocId', 'updatedAt'
            ])
            && incoming().idVerificationStatus in ['not_submitted', 'voluntary_pending']
          )
        );
      allow delete: if isValidId(workerId) && isAdmin();
    }

    match /publicEmployers/{employerId} {
      allow get: if isValidId(employerId);
      allow list: if true;
      allow create: if isValidId(employerId)
        && isOwner(employerId)
        && isValidPublicEmployer(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().verificationStatus == 'pending'
        && isValidTimestampOnCreate();
      allow update: if isValidId(employerId)
        && isVerifiedUser()
        && isValidPublicEmployer(incoming())
        && isValidTimestampOnUpdate()
        && incoming().ownerUid == existing().ownerUid
        && incoming().registrationId == existing().registrationId
        && (
          isAdmin() ||
          (
            isOwner(existing().ownerUid)
            && existing().verificationStatus != 'suspended'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'businessName', 'businessType', 'industryCategory',
              'state', 'district', 'requiredCategories', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(employerId) && isAdmin();
    }

    match /employerPrivate/{employerId} {
      allow get: if isValidId(employerId) && (isOwner(employerId) || isAdmin());
      allow list: if isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(employerId)
        && isOwner(employerId)
        && isValidEmployerPrivate(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().mobileVerified == true
        && isValidTimestampOnCreate();
      allow update: if isValidId(employerId)
        && isVerifiedUser()
        && isValidEmployerPrivate(incoming())
        && isValidTimestampOnUpdate()
        && incoming().ownerUid == existing().ownerUid
        && (
          isAdmin() ||
          (
            isOwner(existing().ownerUid)
            && incoming().mobileVerified == true
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'contactPerson', 'mobile', 'mobileVerified', 'verificationMethod', 'testPinHash',
              'email', 'businessAddress', 'gstNumber', 'establishmentDetails',
              'workforceNotes', 'photoDocId', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(employerId) && isAdmin();
    }

    match /jobs/{jobId} {
      allow get: if isValidId(jobId);
      allow list: if true;
      allow create: if isValidId(jobId)
        && isVerifiedUser()
        && isValidJob(incoming())
        && incoming().employerUid == request.auth.uid
        && incoming().status == 'open'
        && incoming().applicationsCount == 0
        && isValidTimestampOnCreate();
      allow update: if isValidId(jobId)
        && isVerifiedUser()
        && isValidJob(incoming())
        && isValidTimestampOnUpdate()
        && incoming().employerUid == existing().employerUid
        && (
          isAdmin() ||
          (
            isOwner(existing().employerUid)
            && !(existing().status in ['completed', 'cancelled'])
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'category', 'description', 'workersRequired',
              'requiredSkills', 'state', 'district', 'cityOrVillage',
              'workLocationLabel', 'lat', 'lng', 'jobDate', 'startTime',
              'duration', 'workType', 'offeredWage', 'wageUnit',
              'paymentTerms', 'contactPreference', 'isWomenFriendly',
              'isAccessible', 'biddingEnabled', 'photoAttachment', 'photoAnalyzed',
              'status', 'dealStatus', 'acceptedApplicationId', 'acceptedWorkerUid',
              'notifiedWorkerUids', 'approxLocationLabel', 'initialRadiusKm',
              'currentRadiusKm', 'radiusStageUpdatedAt', 'updatedAt'
            ])
          ) ||
          (
            existing().status == 'open'
            && incoming().diff(existing()).affectedKeys().hasOnly(['applicationsCount', 'dealStatus', 'updatedAt'])
            && incoming().applicationsCount >= existing().applicationsCount
            && incoming().applicationsCount <= existing().applicationsCount + 1
            && (!('dealStatus' in incoming()) || incoming().dealStatus in ['REQUESTED', 'NOTIFIED', 'OFFER_RECEIVED'])
          ) ||
          (
            'acceptedWorkerUid' in existing()
            && existing().acceptedWorkerUid == request.auth.uid
            && !(existing().status in ['completed', 'cancelled'])
            && incoming().diff(existing()).affectedKeys().hasOnly(['dealStatus', 'status', 'updatedAt'])
            && isValidDealStatus(incoming().dealStatus)
            && incoming().dealStatus in ['OFFER_ACCEPTED', 'DEAL_CONFIRMED', 'WORK_IN_PROGRESS', 'WORK_COMPLETED', 'CANCELLED']
          ) ||
          (
            existing().status == 'open'
            && 'acceptedApplicationId' in incoming()
            && 'acceptedWorkerUid' in incoming()
            && incoming().acceptedWorkerUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['acceptedApplicationId', 'acceptedWorkerUid', 'dealStatus', 'status', 'updatedAt'])
            && incoming().status == 'in_progress'
            && incoming().dealStatus == 'OFFER_ACCEPTED'
            && exists(/databases/$(database)/documents/applications/$(incoming().acceptedApplicationId))
            && get(/databases/$(database)/documents/applications/$(incoming().acceptedApplicationId)).data.workerUid == request.auth.uid
            && get(/databases/$(database)/documents/applications/$(incoming().acceptedApplicationId)).data.jobId == jobId
            && get(/databases/$(database)/documents/applications/$(incoming().acceptedApplicationId)).data.status in ['invited', 'accepted']
          )
        );
      allow delete: if isValidId(jobId) && isAdmin();
    }

    match /applications/{applicationId} {
      allow get: if isValidId(applicationId)
        && isVerifiedUser()
        && (existing().workerUid == request.auth.uid || existing().employerUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser()
        && (existing().workerUid == request.auth.uid || existing().employerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(applicationId)
        && isVerifiedUser()
        && isValidApplication(incoming())
        && (
          (incoming().workerUid == request.auth.uid && incoming().status == 'applied') ||
          (incoming().employerUid == request.auth.uid && incoming().status == 'invited')
        )
        && incoming().liveTrackingAuthorized == false
        && isValidTimestampOnCreate()
        && get(/databases/$(database)/documents/jobs/$(incoming().jobId)).data.employerUid == incoming().employerUid;
      allow update: if isValidId(applicationId)
        && isVerifiedUser()
        && isValidApplication(incoming())
        && isValidTimestampOnUpdate()
        && incoming().jobId == existing().jobId
        && incoming().employerUid == existing().employerUid
        && incoming().workerUid == existing().workerUid
        && (
          isAdmin() ||
          (
            !(existing().status == 'work_completed' || ('dealStatus' in existing() && existing().dealStatus in ['WORK_COMPLETED', 'CANCELLED']))
            && isOwner(existing().workerUid)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'dealStatus', 'proposedWage', 'offerAmount', 'estimatedArrivalTime',
              'offerMessage', 'offerSubmittedAt', 'note', 'liveTrackingAuthorized',
              'dealConfirmedAt', 'workStartedAt', 'completedAt', 'cancelledAt',
              'cancelledByUid', 'updatedAt'
            ])
            && incoming().status in ['applied', 'accepted', 'declined', 'work_completed']
            && (incoming().status != 'accepted' || existing().status in ['invited', 'accepted'])
            && (incoming().status != 'work_completed' || existing().status == 'accepted')
            && (!incoming().liveTrackingAuthorized || incoming().status == 'accepted')
          ) ||
          (
            !(existing().status == 'work_completed' || ('dealStatus' in existing() && existing().dealStatus in ['WORK_COMPLETED', 'CANCELLED']))
            && isOwner(existing().employerUid)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'dealStatus', 'agreedPrice', 'dealConfirmedAt',
              'completedAt', 'cancelledAt', 'cancelledByUid',
              'workerRating', 'employerFeedback', 'updatedAt'
            ])
            && incoming().status in ['invited', 'accepted', 'declined', 'work_completed']
          )
        );
      allow delete: if isValidId(applicationId) && isAdmin();
    }

    match /partnershipEnquiries/{enquiryId} {
      allow get: if isValidId(enquiryId) && isVerifiedUser() && (existing().submitterUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (existing().submitterUid == request.auth.uid || isAdmin());
      allow create: if isValidId(enquiryId)
        && isVerifiedUser()
        && isValidPartnershipEnquiry(incoming())
        && incoming().submitterUid == request.auth.uid
        && incoming().status == 'received'
        && isValidTimestampOnCreate();
      allow update: if isValidId(enquiryId)
        && isAdmin()
        && isValidPartnershipEnquiry(incoming())
        && isValidTimestampOnUpdate()
        && incoming().submitterUid == existing().submitterUid;
      allow delete: if isValidId(enquiryId) && isAdmin();
    }

    match /grievances/{grievanceId} {
      allow get: if isValidId(grievanceId) && isVerifiedUser() && (existing().reporterUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (existing().reporterUid == request.auth.uid || isAdmin());
      allow create: if isValidId(grievanceId)
        && isVerifiedUser()
        && isValidGrievance(incoming())
        && incoming().reporterUid == request.auth.uid
        && incoming().status == 'open'
        && isValidTimestampOnCreate();
      allow update: if isValidId(grievanceId)
        && isAdmin()
        && isValidGrievance(incoming())
        && isValidTimestampOnUpdate()
        && incoming().reporterUid == existing().reporterUid;
      allow delete: if isValidId(grievanceId) && isAdmin();
    }

    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId);
      allow list: if true;
      allow create: if isValidId(announcementId)
        && isAdmin()
        && isValidAnnouncement(incoming())
        && isValidTimestampOnCreate();
      allow update: if isValidId(announcementId)
        && isAdmin()
        && isValidAnnouncement(incoming())
        && isValidTimestampOnUpdate();
      allow delete: if isValidId(announcementId) && isAdmin();
    }

    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(logId)
        && isAdmin()
        && isValidAuditLog(incoming())
        && incoming().adminUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /vehicleListings/{vehicleId} {
      allow get: if isValidId(vehicleId);
      allow list: if true;
      allow create: if isValidId(vehicleId)
        && isVerifiedUser()
        && isValidVehicleListing(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().verificationStatus == 'pending'
        && incoming().completedTripsCount == 0
        && incoming().ratingAvg == 0
        && isValidTimestampOnCreate();
      allow update: if isValidId(vehicleId)
        && isVerifiedUser()
        && isValidVehicleListing(incoming())
        && isValidTimestampOnUpdate()
        && incoming().ownerUid == existing().ownerUid
        && incoming().registrationId == existing().registrationId
        && (
          isAdmin() ||
          (
            isOwner(existing().ownerUid)
            && existing().verificationStatus != 'suspended'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'ownerDisplayName', 'vehicleType', 'vehicleTitle', 'vehicleNumberMasked',
              'seatingOrCapacity', 'acAvailable', 'withDriver', 'ratePerKm', 'ratePerDay',
              'minFare', 'availabilityStatus', 'state', 'district', 'cityOrVillage',
              'approxLat', 'approxLng', 'languagesKnown', 'serviceNotes', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(vehicleId) && isAdmin();
    }

    match /vehiclePrivate/{vehicleId} {
      allow get: if isValidId(vehicleId)
        && isVerifiedUser()
        && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(vehicleId)
        && isVerifiedUser()
        && isValidVehiclePrivate(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().mobileVerified == true
        && isValidTimestampOnCreate();
      allow update: if isValidId(vehicleId)
        && isVerifiedUser()
        && isValidVehiclePrivate(incoming())
        && isValidTimestampOnUpdate()
        && incoming().ownerUid == existing().ownerUid
        && (
          isAdmin() ||
          (
            isOwner(existing().ownerUid)
            && incoming().mobileVerified == true
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'ownerName', 'mobile', 'mobileVerified', 'verificationMethod', 'testPinHash',
              'email', 'rcOrLicenseNotes', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(vehicleId) && isAdmin();
    }

    match /vehicleBookings/{bookingId} {
      allow get: if isValidId(bookingId)
        && isVerifiedUser()
        && (existing().customerUid == request.auth.uid || existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser()
        && (existing().customerUid == request.auth.uid || existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(bookingId)
        && isVerifiedUser()
        && isValidVehicleBooking(incoming())
        && incoming().customerUid == request.auth.uid
        && incoming().status == 'requested'
        && isValidTimestampOnCreate()
        && get(/databases/$(database)/documents/vehicleListings/$(incoming().vehicleId)).data.ownerUid == incoming().ownerUid;
      allow update: if isValidId(bookingId)
        && isVerifiedUser()
        && isValidVehicleBooking(incoming())
        && isValidTimestampOnUpdate()
        && incoming().vehicleId == existing().vehicleId
        && incoming().ownerUid == existing().ownerUid
        && incoming().customerUid == existing().customerUid
        && !(existing().status in ['completed', 'cancelled', 'declined'])
        && (
          isAdmin() ||
          (
            isOwner(existing().ownerUid)
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            && incoming().status in ['accepted', 'declined', 'completed']
          ) ||
          (
            isOwner(existing().customerUid)
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            && incoming().status in ['cancelled', 'completed']
          )
        );
      allow delete: if isValidId(bookingId) && isAdmin();
    }

    match /customerPreferences/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidCustomerPreference(incoming())
        && incoming().ownerUid == userId
        && isValidTimestampOnCreate();
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isValidCustomerPreference(incoming())
        && isValidTimestampOnUpdate()
        && incoming().ownerUid == existing().ownerUid
        && (isAdmin() || isOwner(userId));
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /device_tokens/{tokenId} {
      allow get: if isValidId(tokenId)
        && isVerifiedUser()
        && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser()
        && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(tokenId)
        && isVerifiedUser()
        && isValidDeviceToken(incoming())
        && incoming().ownerUid == request.auth.uid
        && isValidTimestampOnCreate();
      allow update: if isValidId(tokenId)
        && isVerifiedUser()
        && isValidDeviceToken(incoming())
        && isValidTimestampOnUpdate()
        && incoming().ownerUid == existing().ownerUid
        && (isAdmin() || isOwner(existing().ownerUid));
      allow delete: if isValidId(tokenId)
        && isVerifiedUser()
        && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    match /notification_preferences/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidNotificationPreferences(incoming())
        && incoming().ownerUid == userId
        && isValidTimestampOnCreate();
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isValidNotificationPreferences(incoming())
        && isValidTimestampOnUpdate()
        && incoming().ownerUid == existing().ownerUid
        && (isAdmin() || isOwner(userId));
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId)
        && isVerifiedUser()
        && (existing().recipientUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser()
        && (existing().recipientUid == request.auth.uid || isAdmin());
      allow create: if isAdmin() || (
        isValidId(notificationId)
        && isVerifiedUser()
        && isValidNotificationRecord(incoming())
        && incoming().senderUid == request.auth.uid
        && incoming().recipientUid != request.auth.uid
        && incoming().dedupeKey == notificationId
        && !exists(/databases/$(database)/documents/notifications/$(notificationId))
        && incoming().isDemo == false
        && incoming().read == false
        && isValidTimestampOnCreate()
        && canNotifyOnDealContext(incoming())
      );
      allow delete: if isAdmin();
      allow update: if isValidId(notificationId)
        && isVerifiedUser()
        && isOwner(existing().recipientUid)
        && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt'])
        && incoming().read is bool
        && isValidTimestampOnUpdate();
    }

    match /notification_delivery_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /demo_accounts/{accountId} {
      allow get: if isValidId(accountId) && isVerifiedUser();
      allow list: if isVerifiedUser();
      allow create: if isValidId(accountId)
        && isAdmin()
        && isValidDemoAccount(incoming())
        && isValidTimestampOnCreate();
      allow update: if isValidId(accountId)
        && isVerifiedUser()
        && isValidDemoAccount(incoming())
        && isValidTimestampOnUpdate()
        && (
          isAdmin() ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['assignedUid', 'notificationsEnabled', 'updatedAt'])
            && incoming().assignedUid == request.auth.uid
          )
        );
      allow delete: if isValidId(accountId) && isAdmin();
    }

    match /demo_jobs/{demoJobId} {
      allow get: if isValidId(demoJobId) && isVerifiedUser();
      allow list: if isVerifiedUser();
      allow create: if isValidId(demoJobId)
        && isAdmin()
        && isValidDemoJob(incoming())
        && isValidTimestampOnCreate();
      allow update: if isValidId(demoJobId)
        && isVerifiedUser()
        && isValidDemoJob(incoming())
        && isValidTimestampOnUpdate()
        && (
          isAdmin() ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['applicationsCount', 'updatedAt'])
            && incoming().applicationsCount == existing().applicationsCount + 1
          )
        );
      allow delete: if isValidId(demoJobId) && isAdmin();
    }

    match /demo_applications/{demoAppId} {
      allow get: if isValidId(demoAppId)
        && isVerifiedUser()
        && (existing().applicantUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser()
        && (existing().applicantUid == request.auth.uid || isAdmin());
      allow create: if isValidId(demoAppId)
        && isVerifiedUser()
        && isValidDemoApplication(incoming())
        && incoming().applicantUid == request.auth.uid
        && incoming().status == 'applied'
        && incoming().isDemo == true
        && isValidTimestampOnCreate()
        && exists(/databases/$(database)/documents/demo_jobs/$(incoming().demoJobId));
      allow update, delete: if isValidId(demoAppId) && isAdmin();
    }

    match /platform_settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if isAdmin();
      allow create: if isValidId(settingId)
        && isAdmin()
        && isValidDemoModeConfig(incoming())
        && incoming().updatedByUid == request.auth.uid
        && isValidTimestampOnCreate();
      allow update: if isValidId(settingId)
        && isAdmin()
        && isValidDemoModeConfig(incoming())
        && incoming().updatedByUid == request.auth.uid
        && isValidTimestampOnUpdate();
      allow delete: if isValidId(settingId) && isAdmin();
    }

    match /demo_users/{demoUserId} {
      allow get, list: if isVerifiedUser()
        && (isDemoModeEnabled() || isAdmin());
      allow create: if isValidId(demoUserId)
        && isVerifiedUser()
        && (isDemoModeEnabled() || isAdmin())
        && isValidDemoUserProfile(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().isDemo == true
        && isValidTimestampOnCreate()
        && existsAfter(/databases/$(database)/documents/demo_mobile_registry/$( 'mob_' + incoming().mobile10 ));
      allow update: if isValidId(demoUserId)
        && isVerifiedUser()
        && (isDemoModeEnabled() || isAdmin())
        && isValidDemoUserProfile(incoming())
        && isValidTimestampOnUpdate()
        && incoming().ownerUid == existing().ownerUid
        && incoming().uniqueUserId == existing().uniqueUserId
        && incoming().mobile10 == existing().mobile10
        && (isOwner(existing().ownerUid) || isAdmin());
      allow delete: if isValidId(demoUserId)
        && isVerifiedUser()
        && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    match /demo_mobile_registry/{mobileKey} {
      allow get: if isValidId(mobileKey)
        && isVerifiedUser()
        && (isDemoModeEnabled() || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(mobileKey)
        && isVerifiedUser()
        && (isDemoModeEnabled() || isAdmin())
        && isValidDemoMobileRegistry(incoming())
        && incoming().ownerUid == request.auth.uid
        && mobileKey == ('mob_' + incoming().mobile10)
        && !exists(/databases/$(database)/documents/demo_mobile_registry/$(mobileKey))
        && isValidTimestampOnCreate();
      allow update: if false;
      allow delete: if isValidId(mobileKey)
        && isVerifiedUser()
        && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    match /demo_work_orders/{orderId} {
      allow get, list: if isVerifiedUser()
        && (isDemoModeEnabled() || isAdmin())
        && (
          isAdmin()
          || existing().ownerUid == request.auth.uid
          || request.auth.uid in existing().matchedWorkerOwnerUids
          || ('acceptedWorkerOwnerUid' in existing() && existing().acceptedWorkerOwnerUid == request.auth.uid)
        );
      allow create: if isValidId(orderId)
        && isVerifiedUser()
        && (isDemoModeEnabled() || isAdmin())
        && isValidDemoWorkOrder(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().status == 'requested'
        && isValidTimestampOnCreate();
      allow update: if isValidId(orderId)
        && isVerifiedUser()
        && (isDemoModeEnabled() || isAdmin())
        && isValidDemoWorkOrder(incoming())
        && isValidTimestampOnUpdate()
        && incoming().ownerUid == existing().ownerUid
        && (
          isAdmin()
          || isOwner(existing().ownerUid)
          || (
            request.auth.uid in existing().matchedWorkerOwnerUids
            && existing().status == 'requested'
            && (
              (
                incoming().status == 'accepted'
                && incoming().acceptedWorkerOwnerUid == request.auth.uid
              )
              || incoming().status in ['requested', 'declined']
            )
          )
          || (
            'acceptedWorkerOwnerUid' in existing()
            && existing().acceptedWorkerOwnerUid == request.auth.uid
            && existing().status in ['accepted', 'customer_confirmed', 'in_progress']
            && incoming().status in ['accepted', 'customer_confirmed', 'in_progress', 'completed']
          )
        );
      allow delete: if isValidId(orderId)
        && isVerifiedUser()
        && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    match /demo_location_shares/{shareId} {
      allow get, list: if isVerifiedUser()
        && (isDemoModeEnabled() || isAdmin())
        && (
          isAdmin()
          || existing().ownerUid == request.auth.uid
          || request.auth.uid in existing().authorizedOwnerUids
        );
      allow create: if isValidId(shareId)
        && isVerifiedUser()
        && (isDemoModeEnabled() || isAdmin())
        && isValidDemoLiveLocationShare(incoming())
        && incoming().ownerUid == request.auth.uid
        && isValidTimestampOnCreate()
        && (
          !incoming().sharingActive ||
          get(/databases/$(database)/documents/demo_work_orders/$(incoming().orderId)).data.status in ['accepted', 'customer_confirmed', 'in_progress']
        );
      allow update: if isValidId(shareId)
        && isVerifiedUser()
        && (isDemoModeEnabled() || isAdmin())
        && isValidDemoLiveLocationShare(incoming())
        && isValidTimestampOnUpdate()
        && incoming().ownerUid == existing().ownerUid
        && incoming().orderId == existing().orderId
        && (
          isAdmin()
          || isOwner(existing().ownerUid)
          || (
            request.auth.uid in existing().authorizedOwnerUids
            && incoming().sharingActive == false
            && incoming().lat == existing().lat
            && incoming().lng == existing().lng
          )
        )
        && (
          !incoming().sharingActive ||
          get(/databases/$(database)/documents/demo_work_orders/$(incoming().orderId)).data.status in ['accepted', 'customer_confirmed', 'in_progress']
        );
      allow delete: if isValidId(shareId)
        && isVerifiedUser()
        && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    match /demo_notifications/{notifId} {
      allow get, list: if isVerifiedUser()
        && (isDemoModeEnabled() || isAdmin())
        && (
          isAdmin()
          || existing().recipientOwnerUid == request.auth.uid
          || existing().senderOwnerUid == request.auth.uid
        );
      allow create: if isValidId(notifId)
        && isVerifiedUser()
        && (isDemoModeEnabled() || isAdmin())
        && isValidDemoNotificationRecord(incoming())
        && incoming().senderOwnerUid == request.auth.uid
        && incoming().dedupeKey == notifId
        && !exists(/databases/$(database)/documents/demo_notifications/$(notifId))
        && isValidTimestampOnCreate();
      allow update: if isValidId(notifId)
        && isVerifiedUser()
        && (isDemoModeEnabled() || isAdmin())
        && isValidDemoNotificationRecord(incoming())
        && isValidTimestampOnUpdate()
        && incoming().senderOwnerUid == existing().senderOwnerUid
        && incoming().recipientOwnerUid == existing().recipientOwnerUid
        && (
          isAdmin()
          || (
            isOwner(existing().recipientOwnerUid)
            && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt'])
          )
          || (
            isOwner(existing().senderOwnerUid)
            && incoming().diff(existing()).affectedKeys().hasOnly(['fcmPushStatus', 'fcmErrorReason', 'updatedAt'])
          )
        );
      allow delete: if isValidId(notifId)
        && isVerifiedUser()
        && (existing().ownerUid == request.auth.uid || existing().recipientOwnerUid == request.auth.uid || isAdmin());
    }

    match /profilePhotos/{photoId} {
      allow get: if isValidId(photoId)
        && isVerifiedUser()
        && (isOwner(existing().ownerUid) || isAdmin() || existing().role == 'worker');
      allow list: if isVerifiedUser()
        && (existing().ownerUid == request.auth.uid || isAdmin() || existing().role == 'worker');
      allow create: if isValidId(photoId)
        && isVerifiedUser()
        && isOwner(incoming().ownerUid)
        && isValidProfilePhoto(incoming())
        && isValidTimestampOnCreate();
      allow update: if isValidId(photoId)
        && isVerifiedUser()
        && isOwner(existing().ownerUid)
        && isValidProfilePhoto(incoming())
        && isValidTimestampOnUpdate()
        && incoming().ownerUid == existing().ownerUid
        && incoming().subjectId == existing().subjectId
        && incoming().role == existing().role;
      allow delete: if isValidId(photoId)
        && isVerifiedUser()
        && (isOwner(existing().ownerUid) || isAdmin());
    }

    match /acceptedCustomerPhotos/{grantId} {
      allow get: if isValidId(grantId)
        && isVerifiedUser()
        && (isAdmin() || existing().ownerUid == request.auth.uid || existing().workerUid == request.auth.uid);
      allow list: if isVerifiedUser()
        && (isAdmin() || existing().ownerUid == request.auth.uid || existing().workerUid == request.auth.uid);
      allow create: if isValidId(grantId)
        && isVerifiedUser()
        && isOwner(incoming().ownerUid)
        && isValidAcceptedCustomerPhoto(incoming())
        && isAcceptedJobGrantValid(incoming())
        && isValidTimestampOnCreate();
      allow update: if isValidId(grantId)
        && isVerifiedUser()
        && isOwner(existing().ownerUid)
        && incoming().ownerUid == existing().ownerUid
        && incoming().workerUid == existing().workerUid
        && incoming().sourceType == existing().sourceType
        && incoming().sourceId == existing().sourceId
        && isValidAcceptedCustomerPhoto(incoming())
        && isAcceptedJobGrantValid(incoming())
        && isValidTimestampOnUpdate();
      allow delete: if isValidId(grantId)
        && isVerifiedUser()
        && (isOwner(existing().ownerUid) || isAdmin());
    }

    match /mobileUniquenessLocks/{lockId} {
      allow get: if isValidId(lockId) && isVerifiedUser();
      allow list: if isAdmin();
      allow create: if isValidId(lockId)
        && isVerifiedUser()
        && isOwner(incoming().ownerUid)
        && isValidMobileUniquenessLock(incoming())
        && !exists(/databases/$(database)/documents/mobileUniquenessLocks/$(lockId))
        && isValidTimestampOnCreate();
      allow update: if isValidId(lockId)
        && isVerifiedUser()
        && isOwner(existing().ownerUid)
        && incoming().ownerUid == existing().ownerUid
        && isValidMobileUniquenessLock(incoming())
        && isValidTimestampOnUpdate();
      allow delete: if isValidId(lockId)
        && isVerifiedUser()
        && (isOwner(existing().ownerUid) || isAdmin());
    }

    match /dealMessages/{messageId} {
      allow get: if isValidId(messageId)
        && isVerifiedUser()
        && (existing().employerUid == request.auth.uid || existing().workerUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser()
        && (existing().employerUid == request.auth.uid || existing().workerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(messageId)
        && isVerifiedUser()
        && isValidDealMessage(incoming())
        && incoming().senderUid == request.auth.uid
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/applications/$(incoming().applicationId))
        && get(/databases/$(database)/documents/applications/$(incoming().applicationId)).data.employerUid == incoming().employerUid
        && get(/databases/$(database)/documents/applications/$(incoming().applicationId)).data.workerUid == incoming().workerUid
        && (
          (incoming().senderRole == 'customer' && request.auth.uid == incoming().employerUid) ||
          (incoming().senderRole == 'worker' && request.auth.uid == incoming().workerUid)
        );
      allow update: if false;
      allow delete: if isValidId(messageId) && isAdmin();
    }

    match /dealLocationShares/{shareId} {
      allow get: if isValidId(shareId)
        && isVerifiedUser()
        && (request.auth.uid in existing().authorizedUids || isAdmin());
      allow list: if isVerifiedUser()
        && (request.auth.uid in existing().authorizedUids || isAdmin());
      allow create: if isValidId(shareId)
        && isVerifiedUser()
        && isValidDealLocationShare(incoming())
        && incoming().ownerUid == request.auth.uid
        && request.auth.uid in incoming().authorizedUids
        && isValidTimestampOnCreate()
        && isActiveAcceptedDeal(incoming().applicationId)
        && get(/databases/$(database)/documents/applications/$(incoming().applicationId)).data.employerUid in incoming().authorizedUids
        && get(/databases/$(database)/documents/applications/$(incoming().applicationId)).data.workerUid in incoming().authorizedUids
        && (
          (incoming().role == 'customer' && request.auth.uid == get(/databases/$(database)/documents/applications/$(incoming().applicationId)).data.employerUid) ||
          (incoming().role == 'worker' && request.auth.uid == get(/databases/$(database)/documents/applications/$(incoming().applicationId)).data.workerUid)
        );
      allow update: if isValidId(shareId)
        && isVerifiedUser()
        && isValidDealLocationShare(incoming())
        && isValidTimestampOnUpdate()
        && incoming().applicationId == existing().applicationId
        && incoming().jobId == existing().jobId
        && incoming().ownerUid == existing().ownerUid
        && incoming().role == existing().role
        && incoming().authorizedUids == existing().authorizedUids
        && (
          isAdmin()
          || (
            isOwner(existing().ownerUid)
            && (!incoming().sharingActive || isActiveAcceptedDeal(existing().applicationId))
          )
          || (
            request.auth.uid in existing().authorizedUids
            && incoming().sharingActive == false
            && incoming().lat == existing().lat
            && incoming().lng == existing().lng
          )
        );
      allow delete: if isValidId(shareId)
        && isVerifiedUser()
        && (isOwner(existing().ownerUid) || isAdmin());
    }
  }
}
