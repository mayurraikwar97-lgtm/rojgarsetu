              'notifiedWorkerUids', 'approxLocationLabel', 'initialRadiusKm',
              'currentRadiusKm', 'radiusStageUpdatedAt', 'updatedAt'
            ])
          ) ||
          (
            existing().status == 'open'
            && incoming().diff(existing()).affectedKeys().hasOnly(['applicationsCount', 'dealStatus', 'updatedAt'])
            && incoming().applicationsCount >= existing().applicationsCount
            && incoming().applicationsCount <= existing().applicationsCount + 1
            && (!('dealStatus' in incoming()) || incoming().dealStatus in ['REQUESTED', 'NOTIFIED', 'OFFER_RECEIVED'])
          ) ||
          (
            'acceptedWorkerUid' in existing()
            && existing().acceptedWorkerUid == request.auth.uid
            && !(existing().status in ['completed', 'cancelled'])
            && incoming().diff(existing()).affectedKeys().hasOnly(['dealStatus', 'status', 'updatedAt'])
