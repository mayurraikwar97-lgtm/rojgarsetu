rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'mayurraikwar97@gmail.com'
      );
    }

    function isDemoModeEnabled() {
      return exists(/databases/$(database)/documents/platform_settings/demo_config)
        && get(/databases/$(database)/documents/platform_settings/demo_config).data.enabled == true;
    }

    function isValidTimestampOnCreate() {
      return incoming().createdAt == request.time && incoming().updatedAt == request.time;
    }

    function isValidTimestampOnUpdate() {
      return incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
    }

    // Entity Validators
    function isValidUserAccount(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'preferredLanguage', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'preferredLanguage', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role in ['worker', 'employer', 'admin']
        && data.preferredLanguage in ['en', 'hi', 'mr']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminMember(data) {
      return data.keys().hasAll(['uid', 'email', 'grantedAt'])
        && data.keys().hasOnly(['uid', 'email', 'grantedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.grantedAt is timestamp;
    }

    function isValidPublicWorker(data) {
      return data.keys().hasAll([
          'ownerUid', 'registrationId', 'displayName', 'primarySkill', 'skills',
          'experienceYears', 'expectedWage', 'wageUnit', 'preferredWorkType',
          'availabilityStatus', 'state', 'district', 'cityOrVillage',
          'approxLat', 'approxLng', 'languagesKnown', 'verificationStatus',
          'completedJobsCount', 'ratingAvg', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'registrationId', 'displayName', 'primarySkill', 'skills',
          'experienceYears', 'expectedWage', 'wageUnit', 'preferredWorkType',
          'availabilityStatus', 'state', 'district', 'cityOrVillage',
          'approxLat', 'approxLng', 'languagesKnown', 'gender', 'education',
          'verificationStatus', 'isWomenEnterprise', 'photoDocId',
          'preferredLanguage', 'preferredRadiusKm', 'voiceAlertsEnabled',
          'completedJobsCount', 'ratingAvg', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerUid)
        && data.registrationId is string && data.registrationId.size() >= 5 && data.registrationId.size() <= 40
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 120
        && data.primarySkill is string && data.primarySkill.size() >= 2 && data.primarySkill.size() <= 80
        && data.skills is list && data.skills.size() >= 1 && data.skills.size() <= 15 && data.skills[0] is string
        && data.experienceYears is number && data.experienceYears >= 0 && data.experienceYears <= 70
        && data.expectedWage is number && data.expectedWage >= 0 && data.expectedWage <= 500000
        && data.wageUnit in ['daily', 'monthly', 'hourly', 'contract']
        && data.preferredWorkType in ['full_time', 'part_time', 'daily_wage', 'contract']
        && data.availabilityStatus in ['available', 'busy', 'offline']
        && data.state is string && data.state.size() >= 2 && data.state.size() <= 80
        && data.district is string && data.district.size() >= 2 && data.district.size() <= 80
        && data.cityOrVillage is string && data.cityOrVillage.size() >= 2 && data.cityOrVillage.size() <= 100
        && data.approxLat is number && data.approxLat >= -90 && data.approxLat <= 90
        && data.approxLng is number && data.approxLng >= -180 && data.approxLng <= 180
        && data.languagesKnown is list && data.languagesKnown.size() >= 1 && data.languagesKnown.size() <= 10 && data.languagesKnown[0] is string
        && (!('gender' in data) || data.gender in ['female', 'male', 'other', 'prefer_not_to_say'])
        && (!('education' in data) || (data.education is string && data.education.size() <= 100))
        && data.verificationStatus in ['pending', 'verified', 'suspended']
        && (!('isWomenEnterprise' in data) || data.isWomenEnterprise is bool)
        && (!('photoDocId' in data) || isValidId(data.photoDocId))
        && (!('preferredLanguage' in data) || data.preferredLanguage in ['en', 'hi', 'mr'])
        && (!('preferredRadiusKm' in data) || data.preferredRadiusKm in [5, 10, 20, 30])
        && (!('voiceAlertsEnabled' in data) || data.voiceAlertsEnabled is bool)
        && data.completedJobsCount is number && data.completedJobsCount >= 0 && data.completedJobsCount <= 100000
        && data.ratingAvg is number && data.ratingAvg >= 0 && data.ratingAvg <= 5
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkerPrivate(data) {
      return data.keys().hasAll([
          'ownerUid', 'fullName', 'mobile', 'mobileVerified', 'ageConfirmed',
          'liveLocationConsent', 'privacyConsent', 'idVerificationStatus',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'fullName', 'mobile', 'mobileVerified', 'verificationMethod',
          'testPinHash', 'email', 'ageConfirmed', 'preferredWorkLocation',
          'liveLocationConsent', 'privacyConsent', 'idVerificationStatus',
          'certificateNotes', 'photoUrl', 'photoDocId', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerUid)
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && data.mobile is string && data.mobile.size() >= 10 && data.mobile.size() <= 20
        && data.mobileVerified is bool
        && (!('verificationMethod' in data) || data.verificationMethod in ['sms_otp', 'firebase_phone', 'test_pin'])
        && (!('testPinHash' in data) || (data.testPinHash is string && data.testPinHash.size() <= 128))
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && data.ageConfirmed is bool
        && (!('preferredWorkLocation' in data) || (data.preferredWorkLocation is string && data.preferredWorkLocation.size() <= 160))
        && data.liveLocationConsent is bool
        && data.privacyConsent is bool
        && data.idVerificationStatus in ['not_submitted', 'voluntary_pending', 'verified']
        && (!('certificateNotes' in data) || (data.certificateNotes is string && data.certificateNotes.size() <= 500))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 1000))
        && (!('photoDocId' in data) || isValidId(data.photoDocId))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPublicEmployer(data) {
      return data.keys().hasAll([
          'ownerUid', 'registrationId', 'businessName', 'businessType',
          'industryCategory', 'state', 'district', 'requiredCategories',
          'verificationStatus', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'registrationId', 'businessName', 'businessType',
          'industryCategory', 'state', 'district', 'requiredCategories',
          'verificationStatus', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerUid)
        && data.registrationId is string && data.registrationId.size() >= 5 && data.registrationId.size() <= 40
        && data.businessName is string && data.businessName.size() >= 2 && data.businessName.size() <= 160
        && data.businessType is string && data.businessType.size() >= 2 && data.businessType.size() <= 80
        && data.industryCategory is string && data.industryCategory.size() >= 2 && data.industryCategory.size() <= 80
        && data.state is string && data.state.size() >= 2 && data.state.size() <= 80
        && data.district is string && data.district.size() >= 2 && data.district.size() <= 80
        && data.requiredCategories is list && data.requiredCategories.size() >= 1 && data.requiredCategories.size() <= 15 && data.requiredCategories[0] is string
        && data.verificationStatus in ['pending', 'verified', 'suspended']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEmployerPrivate(data) {
      return data.keys().hasAll([
          'ownerUid', 'contactPerson', 'mobile', 'mobileVerified',
          'email', 'businessAddress', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'contactPerson', 'mobile', 'mobileVerified', 'verificationMethod',
          'testPinHash', 'email', 'businessAddress', 'gstNumber', 'establishmentDetails',
          'workforceNotes', 'photoDocId', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerUid)
        && data.contactPerson is string && data.contactPerson.size() >= 2 && data.contactPerson.size() <= 120
        && data.mobile is string && data.mobile.size() >= 10 && data.mobile.size() <= 20
        && data.mobileVerified is bool
        && (!('verificationMethod' in data) || data.verificationMethod in ['sms_otp', 'firebase_phone', 'test_pin'])
        && (!('testPinHash' in data) || (data.testPinHash is string && data.testPinHash.size() <= 128))
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.businessAddress is string && data.businessAddress.size() >= 4 && data.businessAddress.size() <= 300
        && (!('gstNumber' in data) || (data.gstNumber is string && data.gstNumber.size() <= 30))
        && (!('establishmentDetails' in data) || (data.establishmentDetails is string && data.establishmentDetails.size() <= 600))
        && (!('workforceNotes' in data) || (data.workforceNotes is string && data.workforceNotes.size() <= 600))
        && (!('photoDocId' in data) || isValidId(data.photoDocId))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDealStatus(s) {
      return s in [
        'REQUESTED', 'NOTIFIED', 'OFFER_RECEIVED', 'OFFER_ACCEPTED',
        'DEAL_CONFIRMED', 'WORK_IN_PROGRESS', 'WORK_COMPLETED', 'CANCELLED', 'REJECTED'
      ];
    }

    function isValidJob(data) {
      return data.keys().hasAll([
          'employerUid', 'employerName', 'title', 'category', 'description',
          'workersRequired', 'requiredSkills', 'state', 'district', 'cityOrVillage',
          'workLocationLabel', 'lat', 'lng', 'workType', 'offeredWage', 'wageUnit',
          'paymentTerms', 'contactPreference', 'isWomenFriendly', 'isAccessible',
          'biddingEnabled', 'status', 'applicationsCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'employerUid', 'employerName', 'title', 'category', 'description',
          'workersRequired', 'requiredSkills', 'state', 'district', 'cityOrVillage',
          'workLocationLabel', 'lat', 'lng', 'jobDate', 'startTime', 'duration',
          'workType', 'offeredWage', 'wageUnit', 'paymentTerms', 'contactPreference',
          'isWomenFriendly', 'isAccessible', 'biddingEnabled', 'photoAttachment',
          'photoAnalyzed', 'status', 'dealStatus', 'acceptedApplicationId',
          'acceptedWorkerUid', 'notifiedWorkerUids', 'approxLocationLabel',
          'initialRadiusKm', 'currentRadiusKm', 'radiusStageUpdatedAt',
          'applicationsCount', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.employerUid)
        && data.employerName is string && data.employerName.size() >= 2 && data.employerName.size() <= 160
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 140
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 80
        && data.description is string && data.description.size() >= 10 && data.description.size() <= 2000
        && data.workersRequired is number && data.workersRequired >= 1 && data.workersRequired <= 5000
        && data.requiredSkills is list && data.requiredSkills.size() >= 1 && data.requiredSkills.size() <= 15 && data.requiredSkills[0] is string
        && data.state is string && data.state.size() >= 2 && data.state.size() <= 80
        && data.district is string && data.district.size() >= 2 && data.district.size() <= 80
        && data.cityOrVillage is string && data.cityOrVillage.size() >= 2 && data.cityOrVillage.size() <= 100
        && data.workLocationLabel is string && data.workLocationLabel.size() >= 2 && data.workLocationLabel.size() <= 160
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && (!('jobDate' in data) || (data.jobDate is string && data.jobDate.size() <= 30))
        && (!('startTime' in data) || (data.startTime is string && data.startTime.size() <= 30))
        && (!('duration' in data) || (data.duration is string && data.duration.size() <= 60))
        && data.workType in ['full_time', 'part_time', 'daily_wage', 'contract', 'temporary', 'urgent', 'bulk']
        && data.offeredWage is number && data.offeredWage >= 0 && data.offeredWage <= 500000
        && data.wageUnit in ['daily', 'monthly', 'hourly', 'contract']
        && data.paymentTerms is string && data.paymentTerms.size() <= 200
        && data.contactPreference in ['platform_message', 'phone_after_confirm']
        && data.isWomenFriendly is bool
        && data.isAccessible is bool
        && data.biddingEnabled is bool
        && (!('photoAttachment' in data) || (data.photoAttachment is string && data.photoAttachment.size() <= 100000))
        && (!('photoAnalyzed' in data) || data.photoAnalyzed is bool)
        && data.status in ['open', 'in_progress', 'completed', 'cancelled', 'flagged']
        && (!('dealStatus' in data) || isValidDealStatus(data.dealStatus))
        && (!('acceptedApplicationId' in data) || isValidId(data.acceptedApplicationId))
        && (!('acceptedWorkerUid' in data) || isValidId(data.acceptedWorkerUid))
        && (!('notifiedWorkerUids' in data) || (data.notifiedWorkerUids is list && data.notifiedWorkerUids.size() <= 100))
        && (!('approxLocationLabel' in data) || (data.approxLocationLabel is string && data.approxLocationLabel.size() <= 160))
        && (!('initialRadiusKm' in data) || data.initialRadiusKm in [5, 10, 20, 30])
        && (!('currentRadiusKm' in data) || data.currentRadiusKm in [5, 10, 20, 30])
        && (!('radiusStageUpdatedAt' in data) || data.radiusStageUpdatedAt is timestamp)
        && data.applicationsCount is number && data.applicationsCount >= 0 && data.applicationsCount <= 100000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidApplication(data) {
      return data.keys().hasAll([
          'jobId', 'jobTitle', 'employerUid', 'workerUid', 'workerRegistrationId',
          'workerName', 'workerPrimarySkill', 'proposedWage', 'status',
          'liveTrackingAuthorized', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'jobId', 'jobTitle', 'employerUid', 'workerUid', 'workerRegistrationId',
          'workerName', 'workerPrimarySkill', 'workerPhotoDocId', 'proposedWage', 'note', 'status',
          'dealStatus', 'initiatedBy', 'jobCategory', 'jobDistrict', 'jobLocationLabel',
          'jobDate', 'startTime', 'customerName', 'offerAmount', 'estimatedArrivalTime',
          'offerMessage', 'offerSubmittedAt', 'agreedPrice', 'dealConfirmedAt',
          'workStartedAt', 'completedAt', 'cancelledAt', 'cancelledByUid',
          'liveTrackingAuthorized', 'workerRating', 'employerFeedback',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.jobId)
        && data.jobTitle is string && data.jobTitle.size() >= 2 && data.jobTitle.size() <= 140
        && isValidId(data.employerUid)
        && isValidId(data.workerUid)
        && data.workerRegistrationId is string && data.workerRegistrationId.size() >= 5 && data.workerRegistrationId.size() <= 40
        && data.workerName is string && data.workerName.size() >= 2 && data.workerName.size() <= 120
        && data.workerPrimarySkill is string && data.workerPrimarySkill.size() >= 2 && data.workerPrimarySkill.size() <= 80
        && (!('workerPhotoDocId' in data) || isValidId(data.workerPhotoDocId))
        && data.proposedWage is number && data.proposedWage >= 0 && data.proposedWage <= 500000
        && (!('note' in data) || (data.note is string && data.note.size() <= 600))
        && data.status in ['applied', 'invited', 'accepted', 'declined', 'work_completed']
        && (!('dealStatus' in data) || isValidDealStatus(data.dealStatus))
        && (!('initiatedBy' in data) || data.initiatedBy in ['customer_invite', 'customer_broadcast', 'worker_apply'])
        && (!('jobCategory' in data) || (data.jobCategory is string && data.jobCategory.size() <= 80))
        && (!('jobDistrict' in data) || (data.jobDistrict is string && data.jobDistrict.size() <= 80))
        && (!('jobLocationLabel' in data) || (data.jobLocationLabel is string && data.jobLocationLabel.size() <= 160))
        && (!('jobDate' in data) || (data.jobDate is string && data.jobDate.size() <= 30))
        && (!('startTime' in data) || (data.startTime is string && data.startTime.size() <= 30))
        && (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 160))
        && (!('offerAmount' in data) || (data.offerAmount is number && data.offerAmount >= 0 && data.offerAmount <= 500000))
        && (!('estimatedArrivalTime' in data) || (data.estimatedArrivalTime is string && data.estimatedArrivalTime.size() <= 80))
        && (!('offerMessage' in data) || (data.offerMessage is string && data.offerMessage.size() <= 600))
        && (!('offerSubmittedAt' in data) || data.offerSubmittedAt is timestamp)
        && (!('agreedPrice' in data) || (data.agreedPrice is number && data.agreedPrice >= 0 && data.agreedPrice <= 500000))
        && (!('dealConfirmedAt' in data) || data.dealConfirmedAt is timestamp)
        && (!('workStartedAt' in data) || data.workStartedAt is timestamp)
        && (!('completedAt' in data) || data.completedAt is timestamp)
        && (!('cancelledAt' in data) || data.cancelledAt is timestamp)
        && (!('cancelledByUid' in data) || isValidId(data.cancelledByUid))
        && data.liveTrackingAuthorized is bool
        && (!('workerRating' in data) || (data.workerRating is number && data.workerRating >= 1 && data.workerRating <= 5))
        && (!('employerFeedback' in data) || (data.employerFeedback is string && data.employerFeedback.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPartnershipEnquiry(data) {
      return data.keys().hasAll([
          'submitterUid', 'organisationName', 'departmentOrInstitution',
          'contactPerson', 'designation', 'email', 'phone', 'state',
          'district', 'partnershipInterest', 'message', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'submitterUid', 'organisationName', 'departmentOrInstitution',
          'contactPerson', 'designation', 'email', 'phone', 'state',
          'district', 'partnershipInterest', 'message', 'attachmentName',
          'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.submitterUid)
        && data.organisationName is string && data.organisationName.size() >= 2 && data.organisationName.size() <= 160
        && data.departmentOrInstitution is string && data.departmentOrInstitution.size() >= 2 && data.departmentOrInstitution.size() <= 160
        && data.contactPerson is string && data.contactPerson.size() >= 2 && data.contactPerson.size() <= 120
        && data.designation is string && data.designation.size() >= 2 && data.designation.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 20
        && data.state is string && data.state.size() >= 2 && data.state.size() <= 80
        && data.district is string && data.district.size() >= 2 && data.district.size() <= 80
        && data.partnershipInterest is string && data.partnershipInterest.size() >= 2 && data.partnershipInterest.size() <= 120
        && data.message is string && data.message.size() >= 5 && data.message.size() <= 2000
        && (!('attachmentName' in data) || (data.attachmentName is string && data.attachmentName.size() <= 200))
        && data.status in ['received', 'under_review', 'responded', 'archived']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGrievance(data) {
      return data.keys().hasAll([
          'reporterUid', 'category', 'subject', 'description',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'reporterUid', 'category', 'targetReference', 'subject',
          'description', 'status', 'adminNotes', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.reporterUid)
        && data.category in ['fraudulent_job', 'non_payment', 'harassment', 'unsafe_workplace', 'account_appeal', 'other']
        && (!('targetReference' in data) || (data.targetReference is string && data.targetReference.size() <= 140))
        && data.subject is string && data.subject.size() >= 3 && data.subject.size() <= 160
        && data.description is string && data.description.size() >= 10 && data.description.size() <= 2000
        && data.status in ['open', 'under_review', 'resolved', 'dismissed']
        && (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 1000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll([
          'titleEn', 'titleHi', 'titleMr', 'bodyEn', 'bodyHi', 'bodyMr',
          'active', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'titleEn', 'titleHi', 'titleMr', 'bodyEn', 'bodyHi', 'bodyMr',
          'active', 'createdAt', 'updatedAt'
        ])
        && data.titleEn is string && data.titleEn.size() >= 2 && data.titleEn.size() <= 160
        && data.titleHi is string && data.titleHi.size() >= 2 && data.titleHi.size() <= 160
        && data.titleMr is string && data.titleMr.size() >= 2 && data.titleMr.size() <= 160
        && data.bodyEn is string && data.bodyEn.size() >= 2 && data.bodyEn.size() <= 500
        && data.bodyHi is string && data.bodyHi.size() >= 2 && data.bodyHi.size() <= 500
        && data.bodyMr is string && data.bodyMr.size() >= 2 && data.bodyMr.size() <= 500
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['adminUid', 'adminEmail', 'action', 'targetCollection', 'targetId', 'createdAt'])
        && data.keys().hasOnly(['adminUid', 'adminEmail', 'action', 'targetCollection', 'targetId', 'details', 'createdAt'])
        && isValidId(data.adminUid)
        && data.adminEmail is string && data.adminEmail.size() >= 3 && data.adminEmail.size() <= 200
        && data.action is string && data.action.size() >= 2 && data.action.size() <= 120
        && data.targetCollection is string && data.targetCollection.size() >= 2 && data.targetCollection.size() <= 80
        && data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128
        && (!('details' in data) || (data.details is string && data.details.size() <= 500))
        && data.createdAt is timestamp;
    }

    function isValidVehicleListing(data) {
      return data.keys().hasAll([
          'ownerUid', 'registrationId', 'ownerDisplayName', 'vehicleType', 'vehicleTitle',
          'vehicleNumberMasked', 'seatingOrCapacity', 'acAvailable', 'withDriver',
          'ratePerKm', 'ratePerDay', 'minFare', 'availabilityStatus', 'state', 'district',
          'cityOrVillage', 'approxLat', 'approxLng', 'languagesKnown', 'verificationStatus',
          'completedTripsCount', 'ratingAvg', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'registrationId', 'ownerDisplayName', 'vehicleType', 'vehicleTitle',
          'vehicleNumberMasked', 'seatingOrCapacity', 'acAvailable', 'withDriver',
          'ratePerKm', 'ratePerDay', 'minFare', 'availabilityStatus', 'state', 'district',
          'cityOrVillage', 'approxLat', 'approxLng', 'languagesKnown', 'serviceNotes',
          'verificationStatus', 'completedTripsCount', 'ratingAvg', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerUid)
        && data.registrationId is string && data.registrationId.size() >= 5 && data.registrationId.size() <= 40
        && data.ownerDisplayName is string && data.ownerDisplayName.size() >= 2 && data.ownerDisplayName.size() <= 120
        && data.vehicleType in ['bike_taxi', 'auto_rickshaw', 'car_sedan', 'suv_innova', 'trolley_cart', 'mini_tempo', 'pickup_tempo', 'tractor']
        && data.vehicleTitle is string && data.vehicleTitle.size() >= 2 && data.vehicleTitle.size() <= 120
        && data.vehicleNumberMasked is string && data.vehicleNumberMasked.size() >= 4 && data.vehicleNumberMasked.size() <= 20
        && data.seatingOrCapacity is string && data.seatingOrCapacity.size() >= 1 && data.seatingOrCapacity.size() <= 60
        && data.acAvailable is bool
        && data.withDriver is bool
