rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isStr(v, minLen, maxLen) {
      return v is string && v.size() >= minLen && v.size() <= maxLen;
    }

    function isNum(v, minVal, maxVal) {
      return v is number && v >= minVal && v <= maxVal;
    }

    function optStr(d, k, maxLen) {
      return !(k in d) || (d[k] is string && d[k].size() <= maxLen);
    }

    function optStrR(d, k, minLen, maxLen) {
      return !(k in d) || (d[k] is string && d[k].size() >= minLen && d[k].size() <= maxLen);
    }

    function optNum(d, k, minVal, maxVal) {
      return !(k in d) || (d[k] is number && d[k] >= minVal && d[k] <= maxVal);
    }

    function optBool(d, k) {
      return !(k in d) || d[k] is bool;
    }

    function optId(d, k) {
      return !(k in d) || isValidId(d[k]);
    }

    function optCode(d, k) {
      return !(k in d) || (d[k] is string && d[k].size() >= 4 && d[k].size() <= 32 && d[k].matches('^[A-Z0-9_\\-]+$'));
    }

    function optPhotoList(d, k) {
      return !(k in d) || (d[k] is list && d[k].size() <= 4 && (d[k].size() == 0 || (d[k][0] is string && d[k][0].size() <= 120000)));
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'mayurraikwar97@gmail.com'
      );
    }

    function isDemoModeEnabled() {
      return exists(/databases/$(database)/documents/platform_settings/demo_config)
        && get(/databases/$(database)/documents/platform_settings/demo_config).data.enabled == true;
    }

    function isValidTimestampOnCreate() {
      return incoming().createdAt == request.time && incoming().updatedAt == request.time;
    }

    function isValidTimestampOnUpdate() {
      return incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
    }

    // Entity Validators
    function isValidUserAccount(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'preferredLanguage', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'preferredLanguage', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && isStr(data.email, 3, 200)
        && isStr(data.displayName, 1, 120)
        && data.role in ['worker', 'employer', 'admin']
        && data.preferredLanguage in ['en', 'hi', 'mr']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminMember(data) {
      return data.keys().hasAll(['uid', 'email', 'grantedAt'])
        && data.keys().hasOnly(['uid', 'email', 'grantedAt'])
        && isValidId(data.uid)
        && isStr(data.email, 3, 200)
        && data.grantedAt is timestamp;
    }

    function isValidPublicWorker(data) {
      return data.keys().hasAll([
          'ownerUid', 'registrationId', 'displayName', 'primarySkill', 'skills',
          'experienceYears', 'expectedWage', 'wageUnit', 'preferredWorkType',
          'availabilityStatus', 'state', 'district', 'cityOrVillage',
          'approxLat', 'approxLng', 'languagesKnown', 'verificationStatus',
          'completedJobsCount', 'ratingAvg', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'registrationId', 'displayName', 'primarySkill', 'skills',
          'experienceYears', 'expectedWage', 'wageUnit', 'preferredWorkType',
          'availabilityStatus', 'state', 'district', 'cityOrVillage',
          'approxLat', 'approxLng', 'languagesKnown', 'gender', 'education',
          'verificationStatus', 'registrationPaymentStatus', 'paidBenefitsActive',
          'paymentReceiptNo', 'certificateNo', 'verifiedAtIso',
          'isWomenEnterprise', 'photoDocId',
          'preferredLanguage', 'preferredRadiusKm', 'voiceAlertsEnabled',
          'completedJobsCount', 'ratingAvg', 'lastRatedApplicationId',
          'referralCode', 'referredByCode', 'referredByUid', 'referredByName',
          'customProfessionId', 'customProfessionName', 'customProfessionStatus',
          'workDescription', 'workPhotoUrls',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerUid)
        && isStr(data.registrationId, 5, 40)
        && isStr(data.displayName, 2, 120)
        && isStr(data.primarySkill, 2, 80)
        && data.skills is list && data.skills.size() >= 1 && data.skills.size() <= 15 && data.skills[0] is string
        && isNum(data.experienceYears, 0, 70)
        && isNum(data.expectedWage, 0, 500000)
        && data.wageUnit in ['daily', 'monthly', 'hourly', 'contract']
        && data.preferredWorkType in ['full_time', 'part_time', 'daily_wage', 'contract']
        && data.availabilityStatus in ['available', 'busy', 'offline']
        && isStr(data.state, 2, 80)
        && isStr(data.district, 2, 80)
        && isStr(data.cityOrVillage, 2, 100)
        && isNum(data.approxLat, -90, 90)
        && isNum(data.approxLng, -180, 180)
        && data.languagesKnown is list && data.languagesKnown.size() >= 1 && data.languagesKnown.size() <= 10 && data.languagesKnown[0] is string
        && (!('gender' in data) || data.gender in ['female', 'male', 'other', 'prefer_not_to_say'])
        && optStr(data, 'education', 100)
        && data.verificationStatus in ['pending', 'verified', 'suspended']
        && (!('registrationPaymentStatus' in data) || data.registrationPaymentStatus in ['pending', 'verified', 'failed', 'refunded'])
        && optBool(data, 'paidBenefitsActive')
        && optStr(data, 'paymentReceiptNo', 60)
        && optStr(data, 'certificateNo', 60)
        && optStr(data, 'verifiedAtIso', 40)
        && optBool(data, 'isWomenEnterprise')
        && optId(data, 'photoDocId')
        && (!('preferredLanguage' in data) || data.preferredLanguage in ['en', 'hi', 'mr'])
        && (!('preferredRadiusKm' in data) || data.preferredRadiusKm in [2, 5, 10, 20, 30])
        && optBool(data, 'voiceAlertsEnabled')
        && isNum(data.completedJobsCount, 0, 100000)
        && isNum(data.ratingAvg, 0, 5)
        && optId(data, 'lastRatedApplicationId')
        && optCode(data, 'referralCode')
        && optCode(data, 'referredByCode')
        && optId(data, 'referredByUid')
        && optStrR(data, 'referredByName', 2, 120)
        && (!('customProfessionId' in data) || (isStr(data.customProfessionId, 2, 64) && data.customProfessionId.matches('^[a-z0-9_\\-]+$')))
        && optStrR(data, 'customProfessionName', 2, 80)
        && (!('customProfessionStatus' in data) || data.customProfessionStatus in ['pending', 'approved', 'rejected'])
        && optStr(data, 'workDescription', 500)
        && optPhotoList(data, 'workPhotoUrls')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomProfession(data) {
      return data.keys().hasAll([
          'slug', 'nameEn', 'group', 'keywords', 'status', 'source',
          'createdByUid', 'usageCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'slug', 'nameEn', 'nameHi', 'nameMr', 'description', 'group', 'keywords',
          'status', 'source', 'createdByUid',
          'submittedByWorkerName', 'submittedByWorkerRegistrationId', 'submittedLocation',
          'sampleWorkPhotoUrls', 'expectedWage', 'wageUnit', 'experienceYears',
          'approvedByUid', 'adminNotes', 'usageCount', 'createdAt', 'updatedAt'
        ])
        && isStr(data.slug, 2, 64) && data.slug.matches('^[a-z0-9_\\-]+$')
        && isStr(data.nameEn, 2, 80)
        && optStr(data, 'nameHi', 80)
        && optStr(data, 'nameMr', 80)
        && optStr(data, 'description', 500)
        && data.group in ['trades', 'industrial', 'transport', 'agriculture', 'hospitality', 'office', 'services', 'enterprise']
        && data.keywords is list && data.keywords.size() >= 1 && data.keywords.size() <= 12 && data.keywords[0] is string
        && data.status in ['pending', 'approved', 'rejected']
        && data.source in ['worker_submission', 'admin_created']
        && isValidId(data.createdByUid)
        && optStr(data, 'submittedByWorkerName', 120)
        && optStr(data, 'submittedByWorkerRegistrationId', 40)
        && optStr(data, 'submittedLocation', 140)
        && optPhotoList(data, 'sampleWorkPhotoUrls')
        && optNum(data, 'expectedWage', 0, 500000)
        && (!('wageUnit' in data) || data.wageUnit in ['daily', 'monthly', 'hourly', 'contract'])
        && optNum(data, 'experienceYears', 0, 70)
        && optId(data, 'approvedByUid')
        && optStr(data, 'adminNotes', 500)
        && isNum(data.usageCount, 0, 100000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkerPrivate(data) {
      return data.keys().hasAll([
          'ownerUid', 'fullName', 'mobile', 'mobileVerified', 'ageConfirmed',
          'liveLocationConsent', 'privacyConsent', 'idVerificationStatus',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'fullName', 'mobile', 'mobileVerified', 'verificationMethod',
          'testPinHash', 'email', 'ageConfirmed', 'preferredWorkLocation',
          'liveLocationConsent', 'privacyConsent', 'refundPolicyAccepted',
          'noEmploymentGuaranteeAccepted', 'registrationPaymentStatus',
          'idVerificationStatus',
          'certificateNotes', 'photoUrl', 'photoDocId',
          'referralCode', 'referredByCode', 'referredByUid', 'referredByName',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerUid)
        && isStr(data.fullName, 2, 120)
        && isStr(data.mobile, 10, 20)
        && data.mobileVerified is bool
        && (!('verificationMethod' in data) || data.verificationMethod in ['sms_otp', 'firebase_phone', 'test_pin'])
        && optStr(data, 'testPinHash', 128)
        && optStr(data, 'email', 200)
        && data.ageConfirmed is bool
        && optStr(data, 'preferredWorkLocation', 160)
        && data.liveLocationConsent is bool
        && data.privacyConsent is bool
        && optBool(data, 'refundPolicyAccepted')
        && optBool(data, 'noEmploymentGuaranteeAccepted')
        && (!('registrationPaymentStatus' in data) || data.registrationPaymentStatus in ['pending', 'verified', 'failed', 'refunded'])
        && data.idVerificationStatus in ['not_submitted', 'voluntary_pending', 'verified']
        && optStr(data, 'certificateNotes', 500)
        && optStr(data, 'photoUrl', 1000)
        && optId(data, 'photoDocId')
        && optCode(data, 'referralCode')
        && optCode(data, 'referredByCode')
        && optId(data, 'referredByUid')
        && optStrR(data, 'referredByName', 2, 120)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPublicEmployer(data) {
      return data.keys().hasAll([
          'ownerUid', 'registrationId', 'businessName', 'businessType',
          'industryCategory', 'state', 'district', 'requiredCategories',
          'verificationStatus', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'registrationId', 'businessName', 'businessType',
          'industryCategory', 'state', 'district', 'requiredCategories',
          'verificationStatus', 'gender', 'lastName', 'profileVisibility',
          'hidePhotoUntilConfirm', 'maskedCallingOnly',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerUid)
        && isStr(data.registrationId, 5, 40)
        && isStr(data.businessName, 2, 160)
        && isStr(data.businessType, 2, 80)
        && isStr(data.industryCategory, 2, 80)
        && isStr(data.state, 2, 80)
        && isStr(data.district, 2, 80)
        && data.requiredCategories is list && data.requiredCategories.size() >= 1 && data.requiredCategories.size() <= 15 && data.requiredCategories[0] is string
        && data.verificationStatus in ['pending', 'verified', 'suspended']
        && (!('gender' in data) || data.gender in ['male', 'female', 'other', 'prefer_not_to_say'])
        && optStrR(data, 'lastName', 1, 60)
        && (!('profileVisibility' in data) || data.profileVisibility in ['standard', 'last_name_only', 'private_strict'])
        && optBool(data, 'hidePhotoUntilConfirm')
        && optBool(data, 'maskedCallingOnly')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEmployerPrivate(data) {
      return data.keys().hasAll([
          'ownerUid', 'contactPerson', 'mobile', 'mobileVerified',
          'email', 'businessAddress', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'contactPerson', 'firstName', 'lastName', 'gender', 'profileVisibility',
          'mobile', 'mobileVerified', 'verificationMethod',
          'testPinHash', 'email', 'businessAddress', 'gstNumber', 'establishmentDetails',
          'workforceNotes', 'photoDocId', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerUid)
        && isStr(data.contactPerson, 2, 120)
        && optStr(data, 'firstName', 60)
        && optStr(data, 'lastName', 60)
        && (!('gender' in data) || data.gender in ['male', 'female', 'other', 'prefer_not_to_say'])
        && (!('profileVisibility' in data) || data.profileVisibility in ['standard', 'last_name_only', 'private_strict'])
        && isStr(data.mobile, 10, 20)
        && data.mobileVerified is bool
        && (!('verificationMethod' in data) || data.verificationMethod in ['sms_otp', 'firebase_phone', 'test_pin'])
        && optStr(data, 'testPinHash', 128)
        && isStr(data.email, 3, 200)
        && isStr(data.businessAddress, 4, 300)
        && optStr(data, 'gstNumber', 30)
        && optStr(data, 'establishmentDetails', 600)
        && optStr(data, 'workforceNotes', 600)
        && optId(data, 'photoDocId')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDealStatus(s) {
      return s in [
        'REQUESTED', 'NOTIFIED', 'OFFER_RECEIVED', 'OFFER_ACCEPTED',
        'DEAL_CONFIRMED', 'WORKER_ON_THE_WAY', 'WORKER_ARRIVED',
        'WORK_IN_PROGRESS', 'WORK_COMPLETED', 'CANCELLED', 'REJECTED'
      ];
    }

    function isValidJob(data) {
      return data.keys().hasAll([
          'employerUid', 'employerName', 'title', 'category', 'description',
          'workersRequired', 'requiredSkills', 'state', 'district', 'cityOrVillage',
          'workLocationLabel', 'lat', 'lng', 'workType', 'offeredWage', 'wageUnit',
          'paymentTerms', 'contactPreference', 'isWomenFriendly', 'isAccessible',
          'biddingEnabled', 'status', 'applicationsCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'employerUid', 'employerName', 'customerGenderProtected', 'customerLastName', 'hasExactAddressVault',
          'title', 'category', 'description',
          'workersRequired', 'requiredSkills', 'state', 'district', 'cityOrVillage',
          'workLocationLabel', 'lat', 'lng', 'jobDate', 'startTime', 'duration',
          'workType', 'offeredWage', 'wageUnit', 'paymentTerms', 'contactPreference',
          'isWomenFriendly', 'isAccessible', 'biddingEnabled', 'photoAttachment',
          'workPhotoUrls', 'orderKind', 'pickupLocationLabel', 'pickupLat', 'pickupLng',
          'destinationLocationLabel', 'destinationLat', 'destinationLng', 'transportItemType',
          'photoAnalyzed', 'subService', 'preferredTimeType', 'startingPrice',
          'status', 'dealStatus', 'acceptedApplicationId',
          'acceptedWorkerUid', 'notifiedWorkerUids', 'approxLocationLabel',
          'initialRadiusKm', 'currentRadiusKm', 'radiusStageUpdatedAt',
          'applicationsCount', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.employerUid)
        && data.employerName is string && data.employerName.size() >= 2 && data.employerName.size() <= 160
        && (!('customerGenderProtected' in data) || data.customerGenderProtected is bool)
        && (!('customerLastName' in data) || (data.customerLastName is string && data.customerLastName.size() <= 60))
        && (!('hasExactAddressVault' in data) || data.hasExactAddressVault is bool)
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 140
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 80
        && data.description is string && data.description.size() >= 10 && data.description.size() <= 2000
        && data.workersRequired is number && data.workersRequired >= 1 && data.workersRequired <= 5000
        && data.requiredSkills is list && data.requiredSkills.size() >= 1 && data.requiredSkills.size() <= 15 && data.requiredSkills[0] is string
        && data.state is string && data.state.size() >= 2 && data.state.size() <= 80
        && data.district is string && data.district.size() >= 2 && data.district.size() <= 80
        && data.cityOrVillage is string && data.cityOrVillage.size() >= 2 && data.cityOrVillage.size() <= 100
        && data.workLocationLabel is string && data.workLocationLabel.size() >= 2 && data.workLocationLabel.size() <= 160
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && (!('jobDate' in data) || (data.jobDate is string && data.jobDate.size() <= 30))
        && (!('startTime' in data) || (data.startTime is string && data.startTime.size() <= 30))
        && (!('duration' in data) || (data.duration is string && data.duration.size() <= 60))
        && data.workType in ['full_time', 'part_time', 'daily_wage', 'contract', 'temporary', 'urgent', 'bulk']
        && data.offeredWage is number && data.offeredWage >= 0 && data.offeredWage <= 500000
        && data.wageUnit in ['daily', 'monthly', 'hourly', 'contract']
        && data.paymentTerms is string && data.paymentTerms.size() <= 200
        && data.contactPreference in ['platform_message', 'phone_after_confirm']
        && data.isWomenFriendly is bool
        && data.isAccessible is bool
        && data.biddingEnabled is bool
        && (!('photoAttachment' in data) || (data.photoAttachment is string && data.photoAttachment.size() <= 100000))
        && (!('workPhotoUrls' in data) || (data.workPhotoUrls is list && data.workPhotoUrls.size() <= 6 && (data.workPhotoUrls.size() == 0 || (data.workPhotoUrls[0] is string && data.workPhotoUrls[0].size() <= 85000))))
        && (!('orderKind' in data) || data.orderKind in ['work', 'bike_transport'])
        && (!('pickupLocationLabel' in data) || (data.pickupLocationLabel is string && data.pickupLocationLabel.size() <= 160))
        && (!('pickupLat' in data) || (data.pickupLat is number && data.pickupLat >= -90 && data.pickupLat <= 90))
        && (!('pickupLng' in data) || (data.pickupLng is number && data.pickupLng >= -180 && data.pickupLng <= 180))
        && (!('destinationLocationLabel' in data) || (data.destinationLocationLabel is string && data.destinationLocationLabel.size() <= 160))
        && (!('destinationLat' in data) || (data.destinationLat is number && data.destinationLat >= -90 && data.destinationLat <= 90))
        && (!('destinationLng' in data) || (data.destinationLng is number && data.destinationLng >= -180 && data.destinationLng <= 180))
        && (!('transportItemType' in data) || data.transportItemType in ['person', 'goods'])
        && (!('photoAnalyzed' in data) || data.photoAnalyzed is bool)
        && (!('subService' in data) || (data.subService is string && data.subService.size() <= 100))
        && (!('preferredTimeType' in data) || data.preferredTimeType in ['now', 'later'])
        && (!('startingPrice' in data) || (data.startingPrice is number && data.startingPrice >= 0 && data.startingPrice <= 500000))
        && data.status in ['open', 'in_progress', 'completed', 'cancelled', 'flagged']
        && (!('dealStatus' in data) || isValidDealStatus(data.dealStatus))
        && (!('acceptedApplicationId' in data) || isValidId(data.acceptedApplicationId))
        && (!('acceptedWorkerUid' in data) || isValidId(data.acceptedWorkerUid))
        && (!('notifiedWorkerUids' in data) || (data.notifiedWorkerUids is list && data.notifiedWorkerUids.size() <= 100))
        && (!('approxLocationLabel' in data) || (data.approxLocationLabel is string && data.approxLocationLabel.size() <= 160))
        && (!('initialRadiusKm' in data) || data.initialRadiusKm in [2, 5, 10, 20, 30])
        && (!('currentRadiusKm' in data) || data.currentRadiusKm in [2, 5, 10, 20, 30])
        && (!('radiusStageUpdatedAt' in data) || data.radiusStageUpdatedAt is timestamp)
        && data.applicationsCount is number && data.applicationsCount >= 0 && data.applicationsCount <= 100000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidApplication(data) {
      return data.keys().hasAll([
          'jobId', 'jobTitle', 'employerUid', 'workerUid', 'workerRegistrationId',
          'workerName', 'workerPrimarySkill', 'proposedWage', 'status',
          'liveTrackingAuthorized', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'jobId', 'jobTitle', 'employerUid', 'workerUid', 'workerRegistrationId',
          'workerName', 'workerPrimarySkill', 'workerPhotoDocId', 'proposedWage', 'note', 'status',
          'dealStatus', 'initiatedBy', 'jobCategory', 'jobDistrict', 'jobLocationLabel',
          'jobDate', 'startTime', 'customerName', 'customerGenderProtected', 'customerLastName',
          'offerAmount', 'travelCharges', 'estimatedArrivalTime',
          'offerMessage', 'offerSubmittedAt', 'agreedPrice', 'dealConfirmedAt',
          'onTheWayAt', 'arrivedAt', 'workStartedAt', 'completedAt', 'cancelledAt',
          'cancelledByUid', 'quoteRevisionRequested',
          'liveTrackingAuthorized', 'workerRating', 'employerFeedback',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.jobId)
        && data.jobTitle is string && data.jobTitle.size() >= 2 && data.jobTitle.size() <= 140
        && isValidId(data.employerUid)
        && isValidId(data.workerUid)
        && data.workerRegistrationId is string && data.workerRegistrationId.size() >= 5 && data.workerRegistrationId.size() <= 40
        && data.workerName is string && data.workerName.size() >= 2 && data.workerName.size() <= 120
        && data.workerPrimarySkill is string && data.workerPrimarySkill.size() >= 2 && data.workerPrimarySkill.size() <= 80
        && (!('workerPhotoDocId' in data) || isValidId(data.workerPhotoDocId))
        && data.proposedWage is number && data.proposedWage >= 0 && data.proposedWage <= 500000
        && (!('note' in data) || (data.note is string && data.note.size() <= 600))
        && data.status in ['applied', 'invited', 'accepted', 'declined', 'work_completed']
        && (!('dealStatus' in data) || isValidDealStatus(data.dealStatus))
        && (!('initiatedBy' in data) || data.initiatedBy in ['customer_invite', 'customer_broadcast', 'worker_apply'])
        && (!('jobCategory' in data) || (data.jobCategory is string && data.jobCategory.size() <= 80))
        && (!('jobDistrict' in data) || (data.jobDistrict is string && data.jobDistrict.size() <= 80))
        && (!('jobLocationLabel' in data) || (data.jobLocationLabel is string && data.jobLocationLabel.size() <= 160))
        && (!('jobDate' in data) || (data.jobDate is string && data.jobDate.size() <= 30))
        && (!('startTime' in data) || (data.startTime is string && data.startTime.size() <= 30))
        && (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 160))
        && (!('customerGenderProtected' in data) || data.customerGenderProtected is bool)
        && (!('customerLastName' in data) || (data.customerLastName is string && data.customerLastName.size() <= 60))
        && (!('offerAmount' in data) || (data.offerAmount is number && data.offerAmount >= 0 && data.offerAmount <= 500000))
        && (!('travelCharges' in data) || (data.travelCharges is number && data.travelCharges >= 0 && data.travelCharges <= 100000))
        && (!('estimatedArrivalTime' in data) || (data.estimatedArrivalTime is string && data.estimatedArrivalTime.size() <= 80))
        && (!('offerMessage' in data) || (data.offerMessage is string && data.offerMessage.size() <= 600))
        && (!('offerSubmittedAt' in data) || data.offerSubmittedAt is timestamp)
        && (!('agreedPrice' in data) || (data.agreedPrice is number && data.agreedPrice >= 0 && data.agreedPrice <= 500000))
        && (!('dealConfirmedAt' in data) || data.dealConfirmedAt is timestamp)
        && (!('onTheWayAt' in data) || data.onTheWayAt is timestamp)
        && (!('arrivedAt' in data) || data.arrivedAt is timestamp)
