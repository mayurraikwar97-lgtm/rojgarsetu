# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional server-side Gemini model configuration (never expose keys to browser)
GEMINI_PRIMARY_MODEL="gemini-4-hydrogen"
GEMINI_BACKUP_MODEL="gemini-3.1-flash-lite"
GEMINI_TTS_MODEL="gemini-3.8-flash-lite-tts"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# On Vercel production, set to your live domain:
APP_URL="https://rojgarsetuindia.vercel.app"

# VITE_GOOGLE_MAPS_API_KEY / GOOGLE_MAPS_API_KEY: Google Maps Platform API key.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# OTP_HMAC_SECRET: Server secret for signing mobile OTP challenges (set a random 32+ char string in Vercel / Secrets).
OTP_HMAC_SECRET="REPLACE_WITH_RANDOM_32_PLUS_CHAR_SECRET"

# SMS_PROVIDER: Server-side OTP SMS provider ("2factor" | "msg91" | "fast2sms" | "twilio" | "webhook")
SMS_PROVIDER=""

# Option 0: 2Factor.in (Indian SMS-Only OTP — Voice Call fallback is disabled)
TWOFACTOR_API_KEY=""
# Required for SMS-only delivery (name of your approved DLT OTP template in 2Factor dashboard)
TWOFACTOR_TEMPLATE_NAME=""
# Optional 6-character DLT Sender ID; when set, sends via 2Factor pure Transactional SMS API (ADDON_SERVICES/SEND/TSMS)
TWOFACTOR_SENDER_ID=""

# Option A: MSG91 (Indian DLT-compliant OTP SMS)
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID=""

# Option B: Fast2SMS (Indian DLT / OTP route)
FAST2SMS_API_KEY=""
FAST2SMS_ROUTE="dlt"
FAST2SMS_SENDER_ID=""
FAST2SMS_TEMPLATE_ID=""

# Option C: Twilio (Verify Service OR Programmable SMS)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
TWILIO_FROM_NUMBER=""

# Option D: Custom HTTPS DLT SMS Gateway Webhook
SMS_PROVIDER_API_KEY=""
SMS_GATEWAY_WEBHOOK_URL=""
SMS_DLT_SENDER_ID=""
SMS_DLT_TEMPLATE_ID=""
SMS_DLT_ENTITY_ID=""
SMS_OTP_MESSAGE_TEMPLATE="Your ROJGAR SETU verification OTP is {OTP}. Valid for 5 minutes."

# Firebase Phone Authentication fallback ("true" after enabling Phone provider & adding rojgarsetuindia.vercel.app in Firebase Console)
VITE_FIREBASE_PHONE_AUTH_ENABLED="false"

# VITE_FIREBASE_VAPID_KEY: Web Push certificate public key from Firebase Console -> Cloud Messaging -> Web configuration.
VITE_FIREBASE_VAPID_KEY=""

# VITE_CANONICAL_APP_URL: Canonical production HTTPS URL for share links & notification deep links.
VITE_CANONICAL_APP_URL="https://rojgarsetuindia.vercel.app"

# FIREBASE_SERVICE_ACCOUNT_JSON: Optional Firebase Admin service account JSON string for server-side FCM push delivery.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# VITE_DEMO_MODE_ENABLED: Temporary pre-launch 5-user testing mode ("true" during pre-launch testing, set "false" before public launch).
VITE_DEMO_MODE_ENABLED="true"

